# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=lynxlining
DB_PASSWORD=your_password_here
DB_NAME=lynxlining

# Session
SESSION_SECRET=your_session_secret_here

# Mail (Nodemailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=info@lynx-lining.com
MAIL_PASS=your_mail_password
MAIL_FROM=info@lynx-lining.com
MAIL_TO=info@lynx-lining.com

# Instagram API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn Auto-Import
# Siehe docs/linkedin-automatik.md - LinkedIn selbst bietet fuer persoenliche
# Profile keinen oeffentlichen Feed; LINKEDIN_FEED_URL ist die Feed-Adresse
# eines Dienstes wie rss.app, der das Profil oder die Unternehmensseite abbildet.
LINKEDIN_FEED_URL=
# Abrufintervall in Minuten (Standard 30)
LINKEDIN_SYNC_INTERVAL_MIN=30
# false = importierte Beitraege bleiben versteckt bis zur Freigabe im Admin
LINKEDIN_AUTO_PUBLISH=true
# Gemeinsames Geheimnis fuer POST /api/linkedin/webhook (Zapier/Make/n8n)
LINKEDIN_WEBHOOK_TOKEN=
# Standard-Autor fuer importierte Beitraege
LINKEDIN_AUTHOR_NAME=Martin F. Heidecker

# Automatische Uebersetzung DE -> EN (Claude API)
# Ohne Schluessel zeigt die englische Seite den deutschen Text; im Admin laesst
# sich die Uebersetzung dann von Hand nachtragen.
ANTHROPIC_API_KEY=
# false = Uebersetzung abschalten
LINKEDIN_AUTO_TRANSLATE=true
