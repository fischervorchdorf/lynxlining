# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=lynxlining
DB_PASSWORD=your_password_here
DB_NAME=lynxlining

# Session
SESSION_SECRET=your_session_secret_here

# Mail (Nodemailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=info@lynx-lining.com
MAIL_PASS=your_mail_password
MAIL_FROM=info@lynx-lining.com
MAIL_TO=info@lynx-lining.com

# Instagram API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn - offizielle Community Management API (empfohlener Weg)
# Gilt nur fuer eine LinkedIn-UNTERNEHMENSSEITE. Fuer persoenliche Profile
# vergibt LinkedIn keine Leseberechtigung. Einrichtung: docs/linkedin-automatik.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Muss in der LinkedIn-App exakt so als Redirect-URL eingetragen sein.
# Leer = <SITE_URL>/admin/linkedin/callback
LINKEDIN_REDIRECT_URI=
# API-Version im Format YYYYMM
LINKEDIN_API_VERSION=202606

# LinkedIn Auto-Import - allgemeine Einstellungen
# Ersatzweise: Feed-Adresse (RSS/Atom/JSON), falls kein API-Zugang besteht
LINKEDIN_FEED_URL=
# Abrufintervall in Minuten (Standard 30)
LINKEDIN_SYNC_INTERVAL_MIN=30
# false = importierte Beitraege bleiben versteckt bis zur Freigabe im Admin
LINKEDIN_AUTO_PUBLISH=true
# Gemeinsames Geheimnis fuer POST /api/linkedin/webhook (Zapier/Make/n8n)
LINKEDIN_WEBHOOK_TOKEN=
# Standard-Autor fuer importierte Beitraege
LINKEDIN_AUTHOR_NAME=Martin F. Heidecker

# Automatische Uebersetzung DE -> EN
# Ohne Schluessel wird kostenlos ueber Google Translate uebersetzt (woertlich).
# Mit Schluessel uebersetzt Claude und kennt die Fachbegriffe des
# Verschleissschutzes - wenige Cent pro Beitrag.
ANTHROPIC_API_KEY=
# false = gar keine automatische Uebersetzung
LINKEDIN_AUTO_TRANSLATE=true
