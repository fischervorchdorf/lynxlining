{# ===== FOOTER ===== #}
<footer class="bg-stone-dark text-white/70 pt-20 pb-10 px-6 lg:px-10">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">

    {# Brand #}
    <div>
      <div class="font-heading font-bold text-xl tracking-[3px] text-white mb-4">
        <span class="text-lynx-red">LYNX</span> LINING
      </div>
      <p class="text-sm leading-7 mb-6">{{ t('footer.description') }}</p>
      <div class="flex gap-3">
        <a href="https://www.instagram.com/lynx_lining/" target="_blank" rel="noopener"
           class="w-10 h-10 rounded-xl bg-white/8 flex items-center justify-center text-white hover:bg-lynx-red hover:-translate-y-0.5 transition-all duration-300"
           title="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="mailto:office@lynx-lining.com"
           class="w-10 h-10 rounded-xl bg-white/8 flex items-center justify-center text-white hover:bg-lynx-red hover:-translate-y-0.5 transition-all duration-300"
           title="E-Mail">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
    </div>

    {# Navigation #}
    <div>
      <h4 class="text-white font-heading text-sm font-bold uppercase tracking-wider mb-5">{{ t('footer.navigation') }}</h4>
      <a href="/{{ locale }}" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.home') }}</a>
      <a href="/{{ locale }}/produkte" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.products') }}</a>
      <a href="/{{ locale }}/vorteile" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.advantages') }}</a>
      <a href="/{{ locale }}/anwendungen" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.applications') }}</a>
      <a href="/{{ locale }}/referenzen" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.references') }}</a>
      <a href="/{{ locale }}/galerie" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.gallery') }}</a>
      <a href="/{{ locale }}/shop" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.shop') }}</a>
      <a href="/{{ locale }}/news" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.news') }}</a>
      <a href="/{{ locale }}/kontakt" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('nav.contact') }}</a>
    </div>

    {# Rechtliches #}
    <div>
      <h4 class="text-white font-heading text-sm font-bold uppercase tracking-wider mb-5">{{ t('footer.legal') }}</h4>
      <a href="/{{ locale }}/impressum" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('footer.imprint') }}</a>
      <a href="/{{ locale }}/datenschutz" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('footer.privacy') }}</a>
      <a href="/{{ locale }}/agb" class="block text-sm py-1.5 hover:text-white hover:pl-1 transition-all duration-200">{{ t('footer.terms') }}</a>
    </div>

    {# Kontakt #}
    <div>
      <h4 class="text-white font-heading text-sm font-bold uppercase tracking-wider mb-5">{{ t('footer.contact') }}</h4>
      <p class="text-sm py-1.5">LYNX Lining</p>
      <p class="text-sm py-1.5">Schillerstraße 13</p>
      <p class="text-sm py-1.5">4020 Linz, Austria</p>
      <a href="mailto:office@lynx-lining.com" class="block text-sm py-1.5 text-lynx-red hover:text-lynx-red-light transition-colors mt-2">office@lynx-lining.com</a>
    </div>
  </div>

  {# Bottom Bar #}
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-white/8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
    <span>&copy; {{ currentYear }} LYNX Lining. {{ t('footer.copyright') }}</span>
    <span class="text-white/40">{{ t('footer.ai_notice') }}</span>
    <span>{{ t('footer.made_in') }}</span>
  </div>
</footer>
