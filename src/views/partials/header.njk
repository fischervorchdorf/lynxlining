{# ===== HEADER / NAVIGATION ===== #}
<header class="sticky top-0 z-50 bg-white/97 backdrop-blur-xl border-b border-black/5 transition-shadow duration-300 hover:shadow-lg">
  <div class="max-w-7xl mx-auto flex justify-between items-center px-6 lg:px-10 py-4">

    {# Logo #}
    <a href="/{{ locale }}" class="flex items-center gap-3 no-underline">
      <img src="/images/logo/logo_lynx.png" alt="LYNX Lining Logo" class="h-12 w-auto">
      <span class="font-heading font-bold text-lg tracking-[3px] text-stone-dark">
        <span class="text-lynx-red">LYNX</span> LINING
      </span>
    </a>

    {# Desktop Navigation #}
    <nav class="hidden lg:flex items-center gap-1">
      {% set navItems = [
        { key: 'home', href: '/' + locale },
        { key: 'products', href: '/' + locale + '/produkte' },
        { key: 'advantages', href: '/' + locale + '/vorteile' },
        { key: 'applications', href: '/' + locale + '/anwendungen' },
        { key: 'references', href: '/' + locale + '/referenzen' },
        { key: 'gallery', href: '/' + locale + '/galerie' },
        { key: 'shop', href: '/' + locale + '/shop' },
        { key: 'news', href: '/' + locale + '/news' },
        { key: 'contact', href: '/' + locale + '/kontakt' }
      ] %}

      {% for item in navItems %}
        <a href="{{ item.href }}"
           class="nav-link relative px-4 py-2.5 text-sm font-medium tracking-wide rounded-lg transition-all duration-200
                  {% if page == item.key %}text-lynx-red font-semibold active{% else %}text-stone hover:text-lynx-red hover:bg-lynx-red/5{% endif %}">
          {{ t('nav.' + item.key) }}
        </a>
      {% endfor %}

      {# Sprachumschalter #}
      <div class="flex gap-0.5 ml-4 bg-stone-light rounded-lg p-0.5">
        <a href="{{ localePath('de') }}"
           class="flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all duration-200
                  {% if locale == 'de' %}bg-white text-lynx-red shadow-sm{% else %}text-stone hover:text-lynx-red{% endif %}">
          <img src="/images/icons/flag_de.png" alt="Deutsch" class="w-5 h-3.5 object-cover rounded-sm"> DE
        </a>
        <a href="{{ localePath('en') }}"
           class="flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-md transition-all duration-200
                  {% if locale == 'en' %}bg-white text-lynx-red shadow-sm{% else %}text-stone hover:text-lynx-red{% endif %}">
          <img src="/images/icons/flag_en.png" alt="English" class="w-5 h-3.5 object-cover rounded-sm"> EN
        </a>
      </div>
    </nav>

    {# Mobile Hamburger Button #}
    <button id="mobile-menu-btn" class="lg:hidden p-2 text-stone" aria-label="Menü öffnen">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  {# Mobile Menu Overlay #}
  <div id="mobile-menu" class="mobile-menu fixed inset-0 z-50 bg-white lg:hidden">
    <div class="flex justify-between items-center px-6 py-4 border-b border-black/5">
      <span class="font-heading font-bold text-lg tracking-[3px] text-stone-dark">
        <span class="text-lynx-red">LYNX</span> LINING
      </span>
      <button id="mobile-menu-close" class="p-2 text-stone" aria-label="Menü schließen">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="flex flex-col p-6 gap-2">
      {% for item in navItems %}
        <a href="{{ item.href }}"
           class="px-4 py-3 text-lg font-medium rounded-lg transition-all duration-200
                  {% if page == item.key %}text-lynx-red bg-lynx-red/5{% else %}text-stone hover:text-lynx-red hover:bg-lynx-red/5{% endif %}">
          {{ t('nav.' + item.key) }}
        </a>
      {% endfor %}
      <div class="flex gap-2 mt-4 pt-4 border-t border-stone-light">
        <a href="{{ localePath('de') }}"
           class="flex-1 flex items-center justify-center gap-2 py-2 rounded-lg font-semibold text-sm
                  {% if locale == 'de' %}bg-lynx-red text-white{% else %}bg-stone-light text-stone{% endif %}">
          <img src="/images/icons/flag_de.png" alt="" class="w-6 h-4 object-cover rounded-sm"> Deutsch
        </a>
        <a href="{{ localePath('en') }}"
           class="flex-1 flex items-center justify-center gap-2 py-2 rounded-lg font-semibold text-sm
                  {% if locale == 'en' %}bg-lynx-red text-white{% else %}bg-stone-light text-stone{% endif %}">
          <img src="/images/icons/flag_en.png" alt="" class="w-6 h-4 object-cover rounded-sm"> English
        </a>
      </div>
    </nav>
  </div>
</header>
