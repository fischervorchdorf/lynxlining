{% extends "layouts/main.njk" %}

{% block content %}

<section class="max-w-4xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
  <h1 class="font-heading text-4xl font-extrabold text-stone-dark mb-8">{{ pageContent.title or title }}</h1>

  <div class="prose prose-stone max-w-none">
    {% if pageContent.content %}
      {{ pageContent.content | safe }}
    {% else %}
      <p class="text-stone">
        {% if locale == 'de' %}Inhalt wird geladen...{% else %}Content loading...{% endif %}
      </p>
    {% endif %}
  </div>

  <div class="mt-12">
    <a href="/{{ locale }}" class="inline-flex items-center gap-2 text-lynx-red font-semibold hover:gap-3 transition-all duration-300">
      &larr; {% if locale == 'de' %}Zurück zur Startseite{% else %}Back to homepage{% endif %}
    </a>
  </div>
</section>

{% endblock %}
