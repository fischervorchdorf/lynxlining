{% extends "layouts/main.njk" %}

{% block content %}

{# Hero #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-4xl mx-auto px-6 lg:px-10 text-center">
    <h1 class="font-heading text-3xl lg:text-4xl font-extrabold text-white leading-tight">{{ pageContent.title or title }}</h1>
  </div>
</section>

{# Content #}
<section class="max-w-4xl mx-auto px-6 lg:px-10 -mt-8 relative z-10 pb-24">
  <div class="bg-white rounded-2xl p-8 lg:p-12 shadow-lg border border-black/4">
    <div class="legal-content text-[#3D3D3D] text-[15px] leading-relaxed
      [&_h2]:font-heading [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-[#1E1E1E] [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pb-3 [&_h2]:border-b [&_h2]:border-black/8
      [&_h3]:font-heading [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-[#1E1E1E] [&_h3]:mt-8 [&_h3]:mb-3
      [&_p]:mb-4 [&_p]:leading-relaxed
      [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ul]:space-y-1.5
      [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4 [&_ol]:space-y-1.5
      [&_li]:leading-relaxed
      [&_a]:text-lynx-red [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-lynx-red-dark
      [&_strong]:text-[#1E1E1E] [&_strong]:font-semibold
      [&_table]:w-full [&_table]:border-collapse [&_table]:my-6
      [&_th]:bg-[#F5F5F4] [&_th]:text-left [&_th]:px-4 [&_th]:py-2.5 [&_th]:text-sm [&_th]:font-semibold [&_th]:border [&_th]:border-black/8
      [&_td]:px-4 [&_td]:py-2.5 [&_td]:text-sm [&_td]:border [&_td]:border-black/8">
      {% if pageContent.content %}
        {{ pageContent.content | safe }}
      {% else %}
        <p class="text-stone">
          {% if locale == 'de' %}Inhalt wird geladen...{% else %}Content loading...{% endif %}
        </p>
      {% endif %}
    </div>
  </div>

  <div class="mt-8 text-center">
    <a href="/{{ locale }}" class="inline-flex items-center gap-2 text-lynx-red font-semibold hover:gap-3 transition-all duration-300">
      &larr; {% if locale == 'de' %}Zurück zur Startseite{% else %}Back to homepage{% endif %}
    </a>
  </div>
</section>

{% endblock %}
