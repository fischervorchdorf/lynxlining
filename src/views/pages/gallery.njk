{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('nav.gallery') }}</span>
    <h1 class="font-heading text-4xl lg:text-6xl font-extrabold text-white leading-tight">{{ t('gallery_page.title') }}</h1>
    <p class="text-lg text-white/60 max-w-2xl mx-auto mt-4">{{ t('gallery_page.subtitle') }}</p>
  </div>
</section>

{# ===== FILTER & GALERIE ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-24">

  {# Filter Buttons #}
  <div class="flex flex-wrap justify-center gap-2 mb-12">
    <button class="gallery-filter px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 bg-lynx-red text-white border-lynx-red" data-filter="all">{{ t('gallery_page.filter_all') }}</button>
    <button class="gallery-filter px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="mining">{{ t('gallery_page.filter_mining') }}</button>
    <button class="gallery-filter px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="transport">{{ t('gallery_page.filter_transport') }}</button>
    <button class="gallery-filter px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="recycling">{{ t('gallery_page.filter_recycling') }}</button>
    <button class="gallery-filter px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="production">{{ t('gallery_page.filter_production') }}</button>
  </div>

  {# Gallery Grid #}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="gallery-grid">
    {% if images.length %}
      {% for img in images %}
        <div class="gallery-item group relative overflow-hidden rounded-2xl aspect-square cursor-pointer" data-category="{{ img.category }}" onclick="openLightbox('{{ img.image_path }}', '{{ img.title or img.alt_text }}')">
          <img src="{{ img.image_path }}" alt="{{ img.alt_text or img.title }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="text-white font-heading font-bold text-sm">{{ img.title }}</h3>
              {% if img.caption %}<p class="text-white/70 text-xs mt-1">{{ img.caption }}</p>{% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {# Statische Galerie aus vorhandenen Bildern #}
      {% set staticGallery = [
        { src: "/images/gallery/trichterauskleidung.jpg", title: "Trichterauskleidung", caption: "Bergbau – Steinbruch", cat: "mining" },
        { src: "/images/gallery/lkw_kipper.jpg", title: "LKW Kipper-Auskleidung", caption: "Transport – Nach 43 Monaten", cat: "transport" },
        { src: "/images/gallery/recyclinganlage.jpg", title: "Recyclinganlage", caption: "Aufgabebunker", cat: "recycling" },
        { src: "/images/gallery/foerderband.jpg", title: "Förderband-Abdichtung", caption: "Bergbau – Förderanlage", cat: "mining" },
        { src: "/images/applications/application_bergbau.jpg", title: "Bergbau-Projekt", caption: "Verschleißschutz im Einsatz", cat: "mining" },
        { src: "/images/products/kipper.jpg", title: "Kipper-Detail", caption: "Kippermulde Innenansicht", cat: "transport" },
        { src: "/images/applications/application_schuettgut.jpg", title: "Schüttgut-Anlage", caption: "Verschleißschutz im Einsatz", cat: "mining" },
        { src: "/images/applications/application_recycling.jpg", title: "Recycling-Anlage", caption: "Aufbereitungswerk", cat: "recycling" },
        { src: "/images/products/produkt.JPG", title: "LYNX Lining Folie", caption: "Produktionsrolle", cat: "production" },
        { src: "/images/applications/application_maschinen.jpg", title: "Maschinenbau", caption: "Maschinen-Integration", cat: "production" },
        { src: "/images/applications/application_industrie1.jpg", title: "Industrie-Einsatz", caption: "Industrieanlage", cat: "production" },
        { src: "/images/applications/application_schienen.jpg", title: "Schienenfahrzeug", caption: "Spezialanwendung", cat: "transport" }
      ] %}

      {% for img in staticGallery %}
        <div class="gallery-item group relative overflow-hidden rounded-2xl aspect-square cursor-pointer" data-category="{{ img.cat }}" onclick="openLightbox('{{ img.src }}', '{{ img.title }}')">
          <img src="{{ img.src }}" alt="{{ img.title }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="text-white font-heading font-bold text-sm">{{ img.title }}</h3>
              <p class="text-white/70 text-xs mt-1">{{ img.caption }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{# ===== LIGHTBOX ===== #}
<div id="lightbox" class="fixed inset-0 z-[100] bg-black/90 hidden items-center justify-center" onclick="closeLightbox()">
  <button class="absolute top-6 right-6 text-white/80 hover:text-white text-4xl" onclick="closeLightbox()">&times;</button>
  <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain rounded-lg shadow-2xl" onclick="event.stopPropagation()">
  <div id="lightbox-caption" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white font-heading font-bold text-lg"></div>
</div>

{% endblock %}

{% block scripts %}
<script>
// Galerie-Filter
document.querySelectorAll('.gallery-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter;
    document.querySelectorAll('.gallery-filter').forEach(b => {
      b.classList.remove('bg-lynx-red', 'text-white', 'border-lynx-red');
      b.classList.add('border-stone-light', 'text-stone');
    });
    btn.classList.add('bg-lynx-red', 'text-white', 'border-lynx-red');
    btn.classList.remove('border-stone-light', 'text-stone');

    document.querySelectorAll('.gallery-item').forEach(item => {
      if (filter === 'all' || item.dataset.category === filter) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  });
});

// Lightbox
function openLightbox(src, title) {
  const lb = document.getElementById('lightbox');
  document.getElementById('lightbox-img').src = src;
  document.getElementById('lightbox-caption').textContent = title;
  lb.classList.remove('hidden');
  lb.classList.add('flex');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  const lb = document.getElementById('lightbox');
  lb.classList.add('hidden');
  lb.classList.remove('flex');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
{% endblock %}
