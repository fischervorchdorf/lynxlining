{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-16">
  <div class="max-w-4xl mx-auto px-6 lg:px-10">
    <a href="/{{ locale }}/news" class="inline-flex items-center gap-1.5 text-white/50 hover:text-white text-sm mb-6 transition-colors">
      &larr; {% if locale == 'de' %}Zurück zu News{% else %}Back to News{% endif %}
    </a>
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block px-3 py-1 bg-[#0A66C2]/20 text-[#6CB4FF] text-xs font-bold rounded-full uppercase tracking-wider">LinkedIn</span>
      <span class="text-white/40 text-sm">{{ post.author_name }}</span>
      <span class="text-white/20">|</span>
      <time class="text-white/40 text-sm" datetime="{{ post.published_at }}">{{ post.published_at | formatDate(locale) }}</time>
    </div>
    <h1 class="font-heading text-2xl lg:text-4xl font-extrabold text-white leading-tight">{{ post.title }}</h1>
    {% if post.excerpt %}
      <p class="text-base text-white/60 max-w-3xl mt-3">{{ post.excerpt }}</p>
    {% endif %}
  </div>
</section>

{# ===== CONTENT ===== #}
<section class="max-w-4xl mx-auto px-6 lg:px-10 py-10">

  {% if post.image_path %}
    <div class="mb-8 rounded-2xl overflow-hidden shadow-lg max-w-2xl mx-auto">
      <img src="{{ post.image_path }}" alt="{{ post.title }}" class="w-full h-auto max-h-96 object-cover">
    </div>
  {% endif %}

  {% if post.content %}
    <div class="prose prose-lg max-w-none text-stone-dark leading-relaxed">
      {{ post.content | nl2br | safe }}
    </div>
  {% else %}
    <div class="text-center py-12 text-stone/60">
      <p class="text-lg mb-4">{% if locale == 'de' %}Der vollständige Beitrag ist auf LinkedIn verfügbar.{% else %}The full post is available on LinkedIn.{% endif %}</p>
    </div>
  {% endif %}

  {# LinkedIn Link + Teilen #}
  <div class="mt-10 pt-8 border-t border-black/5 flex flex-col sm:flex-row items-center justify-between gap-4">
    {% if post.linkedin_url %}
      <a href="{{ post.linkedin_url }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-[#0A66C2] text-white rounded-xl font-semibold text-sm hover:bg-[#004182] transition-colors shadow-md">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        {% if locale == 'de' %}Original auf LinkedIn ansehen{% else %}View original on LinkedIn{% endif %}
      </a>
    {% endif %}
    <a href="/{{ locale }}/news" class="text-stone/50 hover:text-lynx-red text-sm font-medium transition-colors">
      &larr; {% if locale == 'de' %}Alle News ansehen{% else %}View all news{% endif %}
    </a>
  </div>

</section>

{% endblock %}
