{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-3">{{ t('nav.shop') }}</span>
    <h1 class="font-heading text-3xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('shop_page.title') }}</h1>
    <p class="text-base text-white/60 max-w-2xl mx-auto mt-3">{{ t('shop_page.subtitle') }}</p>
  </div>
</section>

{# ===== STANDARD PRODUKTE ===== #}
<section id="standard" class="max-w-7xl mx-auto px-6 lg:px-10 -mt-8 relative z-10 pb-8">
  <div class="mb-8">
    <div class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl px-6 py-3">
      <span class="font-heading text-lg lg:text-xl font-extrabold text-white tracking-wide">LYNX Lining Standard</span>
      <span class="w-px h-5 bg-white/25"></span>
      <span class="text-sm text-white/70 font-medium">{{ t('shop_page.roll_material') }}</span>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    {% for prod in products %}
      {% if not prod.price_on_request %}
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg border border-black/4 hover:-translate-y-1 transition-all duration-300 flex flex-col"
             data-product-id="{{ prod.id }}"
             data-product-name="{{ prod.name }}"
             data-product-unit="{{ prod.unit }}"
             data-product-image="{{ prod.image_path }}"
             data-price-tiers='{{ prod.price_tiers | dump | safe }}'>
          <div class="overflow-hidden">
            <img src="{{ prod.image_path }}" alt="{{ prod.name }}" class="w-full h-44 object-cover" loading="lazy">
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-heading text-base font-bold text-stone-dark mb-1">{{ prod.name }}</h3>
            <p class="text-xs text-stone mb-4 flex-1">{{ prod.short_description }}</p>

            {# Rollenpreis (Produzentenpreis = 80% vom Händlerpreis) #}
            {% set haendlerPrice = prod.price_tiers[0].price_per_unit if prod.price_tiers.length else '0' %}
            {% set directPrice = (haendlerPrice | float * 0.80) %}
            <div class="bg-[#FAFAF9] rounded-xl p-4 mb-3 text-center">
              {% set dpInt = (directPrice * 100) | round(0) %}
              {% set dpWhole = (dpInt / 100) | int %}
              {% set dpCents = dpInt % 100 %}
              <span class="text-2xl font-extrabold text-lynx-red">{{ dpWhole }},{% if dpCents < 10 %}0{% endif %}{{ dpCents }} €</span>
              <span class="text-xs text-stone ml-1">{{ t('shop_page.per_roll') }}</span>
              <div class="mt-1">
                <span class="text-xs text-stone/50 italic line-through">{{ haendlerPrice | replace(".", ",") }} €</span>
                <span class="text-xs text-stone/50 italic ml-1">{{ t('shop_page.dealer_price') }}</span>
              </div>
            </div>

            {# Rollendaten Toggle #}
            {% if prod.roll_length_lfm %}
              <button type="button" onclick="this.nextElementSibling.classList.toggle('hidden')" class="text-xs text-lynx-red hover:underline mb-3 text-left">
                {{ t('shop_page.roll_specs') }} &#9662;
              </button>
              <div class="hidden bg-[#FAFAF9] rounded-xl p-3 mb-3 text-xs space-y-1">
                {% if prod.roll_width_mm %}<div class="flex justify-between"><span class="text-stone">{{ t('shop_page.roll_width') }}</span><span class="font-medium">{{ prod.roll_width_mm }} mm</span></div>{% endif %}
                <div class="flex justify-between"><span class="text-stone">{{ t('shop_page.roll_length') }}</span><span class="font-medium">{{ prod.roll_length_lfm }} lfm</span></div>
                {% if prod.sqm_per_roll %}<div class="flex justify-between"><span class="text-stone">{{ t('shop_page.sqm_per_roll') }}</span><span class="font-medium">{{ prod.sqm_per_roll }} m²</span></div>{% endif %}
                {% if prod.roll_weight_kg %}<div class="flex justify-between"><span class="text-stone">{{ t('shop_page.roll_weight') }}</span><span class="font-medium">{{ prod.roll_weight_kg }} kg</span></div>{% endif %}
                {% if prod.roll_outer_diameter_mm %}<div class="flex justify-between"><span class="text-stone">{{ t('shop_page.roll_diameter') }}</span><span class="font-medium">~{{ prod.roll_outer_diameter_mm }} mm</span></div>{% endif %}
                {% if prod.roll_core_diameter_mm %}<div class="flex justify-between"><span class="text-stone">{{ t('shop_page.core_diameter') }}</span><span class="font-medium">{{ prod.roll_core_diameter_mm }} mm</span></div>{% endif %}
              </div>
            {% endif %}

            {# Menge + Warenkorb #}
            <div class="flex items-end gap-2 mt-auto">
              <div class="flex-1">
                <label class="text-xs text-stone mb-1 block">{{ t('shop_page.quantity_rolls') }}</label>
                <input type="number" min="1" step="1" value="1"
                       class="shop-qty w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none"
                       data-product-id="{{ prod.id }}">
              </div>
              <button onclick="addToCart(this.closest('[data-product-id]'))"
                      class="btn-lift px-4 py-2 bg-lynx-red text-white rounded-lg font-semibold text-sm shadow-md hover:bg-lynx-red-dark whitespace-nowrap">
                + {{ t('shop_page.add_to_cart') }}
              </button>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <p class="text-center text-xs text-stone/60 mt-6 mb-4">{{ t('shop_page.ex_works') }}</p>
</section>

{# ===== ROLLENABMESSUNGEN ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 pb-10">
  <div class="bg-[#F0F0EE] border border-black/6 rounded-2xl p-5 lg:p-6">
    <h3 class="font-heading text-sm font-bold text-stone-dark mb-3">{{ t('shop_page.roll_dimensions_title') }}</h3>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
      <div>
        <span class="text-stone text-xs block mb-0.5">{{ t('shop_page.roll_tpu_width') }}</span>
        <span class="font-semibold text-stone-dark">1.515 mm</span>
      </div>
      <div>
        <span class="text-stone text-xs block mb-0.5">{{ t('shop_page.roll_core_width') }}</span>
        <span class="font-semibold text-stone-dark">1.650 mm</span>
      </div>
      <div>
        <span class="text-stone text-xs block mb-0.5">{{ t('shop_page.roll_core_dia') }}</span>
        <span class="font-semibold text-stone-dark">450 mm</span>
      </div>
      <div>
        <span class="text-stone text-xs block mb-0.5">{{ t('shop_page.roll_outer_dia_range') }}</span>
        <span class="font-semibold text-stone-dark">~600 – 800 mm</span>
      </div>
    </div>
    <p class="text-xs text-stone/50 mt-3">{{ t('shop_page.roll_dims_note') }}</p>
  </div>
</section>

{# ===== COMFORT & ULTRA — PREIS AUF ANFRAGE ===== #}
{% set inquiry_products = [] %}
{% for prod in products %}
  {% if prod.price_on_request %}
    {% set _ = inquiry_products.push(prod) %}
  {% endif %}
{% endfor %}

{% if inquiry_products.length %}
{# Dark accent band with badge #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl px-6 py-3">
      <span class="font-heading text-lg lg:text-xl font-extrabold text-white tracking-wide">LYNX Lining Comfort & Ultra</span>
      <span class="w-px h-5 bg-white/25"></span>
      <span class="text-sm text-white/70 font-medium">{{ t('shop_page.price_on_request') }}</span>
    </div>
  </div>
</section>

<section id="comfort-ultra" class="max-w-7xl mx-auto px-6 lg:px-10 -mt-8 relative z-10 pb-12">
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
    {% for prod in inquiry_products %}
      <div class="bg-white rounded-2xl overflow-hidden shadow-lg border border-black/4 hover:-translate-y-1 transition-all duration-300 flex flex-col">
        <div class="overflow-hidden">
          <img src="{{ prod.image_path }}" alt="{{ prod.name }}" class="w-full h-44 object-cover" loading="lazy">
        </div>
        <div class="p-6 flex flex-col flex-1">
          <h3 class="font-heading text-base font-bold text-stone-dark mb-1">{{ prod.name }}</h3>
          <p class="text-xs text-stone mb-4 flex-1">{{ prod.short_description }}</p>

          {# Preis auf Anfrage Box #}
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4 text-center">
            <p class="font-bold text-amber-800 text-sm">{{ t('shop_page.price_on_request') }}</p>
            <p class="text-xs text-amber-700 mt-1">{{ t('shop_page.inquiry_hint') }}</p>
          </div>

          <button onclick="openInquiryForm('{{ prod.name }}')"
                  class="btn-lift w-full px-4 py-2.5 bg-stone-dark text-white rounded-lg font-semibold text-sm shadow-md hover:bg-[#2a2c2e] whitespace-nowrap mt-auto">
            {{ t('shop_page.send_inquiry') }} &rarr;
          </button>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ===== SONDERANFERTIGUNGEN HINWEIS ===== #}
<section class="max-w-5xl mx-auto px-6 lg:px-10 pb-12">
  <div class="bg-stone-dark rounded-2xl p-8 lg:p-10 text-white">
    <div class="flex items-start gap-4">
      <svg class="w-8 h-8 text-lynx-red shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <h3 class="font-heading text-lg font-bold mb-2">{{ t('shop_page.custom_title') }}</h3>
        <p class="text-white/90 text-sm leading-relaxed">{{ t('shop_page.custom_text') }}</p>
        <p class="text-white/70 text-xs mt-3">{{ t('shop_page.custom_minimum') }}</p>
      </div>
    </div>
  </div>
</section>

{# ===== PRAXISFOTOS ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 pb-12">
  <h2 class="font-heading text-xl font-bold text-stone-dark mb-6">{{ t('shop_page.practice_photos') }}</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <img src="/images/products/rolle-palette.jpg" alt="LYNX Lining Rolle auf Palette" class="w-full h-80 object-cover" loading="lazy">
      <div class="bg-white p-4">
        <p class="text-sm text-stone-dark font-medium">{{ t('shop_page.photo_palette') }}</p>
      </div>
    </div>
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <img src="/images/products/rolle-querschnitt.jpg" alt="LYNX Lining Rolle Querschnitt" class="w-full h-80 object-cover" loading="lazy">
      <div class="bg-white p-4">
        <p class="text-sm text-stone-dark font-medium">{{ t('shop_page.photo_cross_section') }}</p>
      </div>
    </div>
  </div>
</section>

{# ===== WARENKORB ===== #}
<section class="max-w-4xl mx-auto px-6 lg:px-10 py-12" id="cart-section">
  <div class="bg-white rounded-2xl shadow-lg border border-black/4 p-8">
    <h2 class="font-heading text-2xl font-bold text-stone-dark mb-6 flex items-center gap-3">
      <svg class="w-6 h-6 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
      </svg>
      {{ t('shop_page.cart') }} <span id="cart-count" class="text-sm bg-lynx-red/10 text-lynx-red px-2.5 py-0.5 rounded-full font-bold">0</span>
    </h2>

    <div id="cart-empty" class="text-center py-8 text-stone">
      <p>{{ t('shop_page.cart_empty') }}</p>
    </div>

    <div id="cart-items" class="hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-black/8">
            <th class="text-left py-3 font-semibold text-stone-dark">{% if locale == 'de' %}Produkt{% else %}Product{% endif %}</th>
            <th class="text-center py-3 font-semibold text-stone-dark">{% if locale == 'de' %}Menge{% else %}Qty{% endif %}</th>
            <th class="text-right py-3 font-semibold text-stone-dark">{% if locale == 'de' %}Preis/Rolle{% else %}Price/roll{% endif %}</th>
            <th class="text-right py-3 font-semibold text-stone-dark">{% if locale == 'de' %}Gesamt{% else %}Total{% endif %}</th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody id="cart-tbody"></tbody>
      </table>

      <div class="flex justify-between items-center border-t-2 border-stone-dark mt-4 pt-4">
        <span class="font-heading text-lg font-bold text-stone-dark">{{ t('shop_page.cart_total') }}</span>
        <span id="cart-total" class="font-heading text-2xl font-extrabold text-lynx-red">€ 0,00</span>
      </div>
      <p class="text-xs text-stone/60 mt-1 text-right">{{ t('shop_page.ex_works') }}</p>

      <div class="mt-6 text-center">
        <button onclick="showOrderForm()" class="btn-lift px-10 py-4 bg-lynx-red text-white rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(214,69,69,0.35)] hover:bg-lynx-red-dark">
          {{ t('shop_page.checkout') }} &rarr;
        </button>
      </div>
    </div>
  </div>
</section>

{# ===== BESTELLFORMULAR ===== #}
<section class="max-w-3xl mx-auto px-6 lg:px-10 pb-24 hidden" id="order-section">
  <div class="bg-white rounded-2xl shadow-lg border border-black/4 p-8 lg:p-10">
    <h2 class="font-heading text-2xl font-bold text-stone-dark mb-2">{{ t('shop_page.order_title') }}</h2>
    <p class="text-stone mb-8">{{ t('shop_page.order_subtitle') }}</p>

    <div id="order-success" class="hidden mb-6 p-5 bg-green-50 border border-green-200 rounded-xl text-green-700">
      <p class="font-semibold">{{ t('shop_page.order_success') }}</p>
      <p class="text-sm mt-1" id="order-number-display"></p>
    </div>
    <div id="order-error" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
      {{ t('shop_page.order_error') }}
    </div>

    <form id="order-form" class="space-y-5">
      <div class="hidden" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.name') }} <span class="text-lynx-red">*</span></label>
          <input type="text" name="customer_name" required
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.company') }}</label>
          <input type="text" name="customer_company"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.email') }} <span class="text-lynx-red">*</span></label>
          <input type="email" name="customer_email" required
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.phone') }}</label>
          <input type="tel" name="customer_phone"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.street') }}</label>
        <input type="text" name="customer_street"
               class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.zip') }}</label>
          <input type="text" name="customer_zip"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.city') }}</label>
          <input type="text" name="customer_city"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.country') }}</label>
          <input type="text" name="customer_country" value="{% if locale == 'de' %}Österreich{% else %}Austria{% endif %}"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.order_message') }}</label>
        <textarea name="customer_message" rows="3"
                  class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none resize-none"></textarea>
      </div>

      {# Bestellzusammenfassung #}
      <div class="bg-[#FAFAF9] rounded-xl p-5 border border-black/4">
        <h3 class="font-heading font-bold text-stone-dark mb-3">{% if locale == 'de' %}Ihre Bestellung{% else %}Your Order{% endif %}</h3>
        <div id="order-summary"></div>
        <div class="flex justify-between items-center border-t border-black/8 mt-3 pt-3">
          <span class="font-bold text-stone-dark">{{ t('shop_page.cart_total') }}</span>
          <span id="order-total" class="font-heading text-xl font-extrabold text-lynx-red">€ 0,00</span>
        </div>
      </div>

      {# DSGVO Checkboxen #}
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <input type="checkbox" id="shop-agb" name="agb_consent" required
                 class="mt-1 w-4 h-4 accent-lynx-red rounded shrink-0">
          <label for="shop-agb" class="text-sm text-stone leading-relaxed">
            {{ t('shop_page.agb_text') }}
            <a href="/{{ locale }}/agb" class="text-lynx-red hover:underline" target="_blank">{{ t('shop_page.agb_link') }}</a>. <span class="text-lynx-red">*</span>
          </label>
        </div>
        <div class="flex items-start gap-3">
          <input type="checkbox" id="shop-privacy" name="privacy_consent" required
                 class="mt-1 w-4 h-4 accent-lynx-red rounded shrink-0">
          <label for="shop-privacy" class="text-sm text-stone leading-relaxed">
            {{ t('shop_page.privacy_text') }}
            <a href="/{{ locale }}/datenschutz" class="text-lynx-red hover:underline" target="_blank">{{ t('shop_page.privacy_link') }}</a>. <span class="text-lynx-red">*</span>
          </label>
        </div>
      </div>

      <button type="submit" id="order-submit-btn" class="btn-lift w-full px-10 py-4 bg-lynx-red text-white rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(214,69,69,0.35)] hover:bg-lynx-red-dark">
        {{ t('shop_page.submit_order') }} &rarr;
      </button>
    </form>
  </div>
</section>

{# ===== ANFRAGE-FORMULAR (Modal) ===== #}
<div id="inquiry-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeInquiryForm()"></div>
  <div class="absolute inset-4 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-lg bg-white rounded-2xl shadow-2xl overflow-y-auto max-h-[90vh]">
    <div class="p-6 lg:p-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-heading text-xl font-bold text-stone-dark">{{ t('shop_page.inquiry_title') }}</h2>
        <button onclick="closeInquiryForm()" class="p-2 text-stone hover:text-stone-dark">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div id="inquiry-success" class="hidden mb-6 p-5 bg-green-50 border border-green-200 rounded-xl text-green-700">
        <p class="font-semibold">{{ t('shop_page.inquiry_success') }}</p>
      </div>
      <div id="inquiry-error" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>

      <form id="inquiry-form" class="space-y-4">
        <div class="hidden" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off">
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.inquiry_product') }}</label>
          <input type="text" name="product_name" id="inquiry-product-name" readonly
                 class="w-full px-4 py-3 bg-[#F0F0EE] border border-black/8 rounded-xl text-stone-dark text-sm">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.inquiry_quantity_lfm') }}</label>
            <input type="number" name="quantity_lfm" min="0" step="1"
                   class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none"
                   placeholder="z.B. 15">
          </div>
          <div>
            <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.inquiry_quantity_sqm') }}</label>
            <input type="number" name="quantity_sqm" min="0" step="1"
                   class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none"
                   placeholder="z.B. 22">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.name') }} <span class="text-lynx-red">*</span></label>
          <input type="text" name="name" required
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.company') }}</label>
          <input type="text" name="company"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.email') }} <span class="text-lynx-red">*</span></label>
          <input type="email" name="email" required
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.phone') }}</label>
          <input type="tel" name="phone"
                 class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none">
        </div>

        <div>
          <label class="block text-sm font-semibold text-stone-dark mb-2">{{ t('shop_page.inquiry_message') }}</label>
          <textarea name="message" rows="3"
                    class="w-full px-4 py-3 bg-[#FAFAF9] border border-black/8 rounded-xl text-stone-dark text-sm focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none resize-none"
                    placeholder="{{ t('shop_page.inquiry_message_placeholder') }}"></textarea>
        </div>

        <button type="submit" id="inquiry-submit-btn" class="btn-lift w-full px-6 py-3 bg-stone-dark text-white rounded-xl font-bold text-sm shadow-md hover:bg-[#2a2c2e]">
          {{ t('shop_page.send_inquiry') }} &rarr;
        </button>
      </form>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
// ===== WARENKORB =====
let cart = JSON.parse(localStorage.getItem('lynxCart') || '[]');

// Produzentenpreis = Händlerpreis × 0.80 (20% Direktvorteil)
const DIRECT_DISCOUNT = 0.80;

function getApplicablePrice(tiers, quantity) {
  let price = tiers[0] ? parseFloat(tiers[0].price_per_unit) : 0;
  for (const tier of tiers) {
    if (quantity >= parseFloat(tier.min_quantity)) {
      price = parseFloat(tier.price_per_unit);
    }
  }
  return Math.round(price * DIRECT_DISCOUNT * 100) / 100;
}

function addToCart(productEl) {
  const id = parseInt(productEl.dataset.productId);
  const name = productEl.dataset.productName;
  const unit = productEl.dataset.productUnit;
  const image = productEl.dataset.productImage;
  const tiers = JSON.parse(productEl.dataset.priceTiers);
  const qtyInput = productEl.querySelector('.shop-qty');
  const qty = parseFloat(qtyInput.value);

  if (isNaN(qty) || qty <= 0) return;

  const price = getApplicablePrice(tiers, qty);
  const existing = cart.find(item => item.id === id);

  if (existing) {
    existing.quantity += qty;
    existing.price = getApplicablePrice(tiers, existing.quantity);
  } else {
    cart.push({ id, name, unit, image, tiers, quantity: qty, price });
  }

  saveCart();
  renderCart();
  qtyInput.value = 1;

  document.getElementById('cart-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function removeFromCart(index) {
  cart.splice(index, 1);
  saveCart();
  renderCart();
}

function updateCartQty(index, newQty) {
  if (newQty <= 0) {
    removeFromCart(index);
    return;
  }
  cart[index].quantity = newQty;
  cart[index].price = getApplicablePrice(cart[index].tiers, newQty);
  saveCart();
  renderCart();
}

function saveCart() {
  localStorage.setItem('lynxCart', JSON.stringify(cart));
}

function formatPrice(num) {
  return num.toFixed(2).replace('.', ',');
}

function renderCart() {
  const emptyEl = document.getElementById('cart-empty');
  const itemsEl = document.getElementById('cart-items');
  const countEl = document.getElementById('cart-count');
  const tbody = document.getElementById('cart-tbody');

  countEl.textContent = cart.length;

  if (cart.length === 0) {
    emptyEl.classList.remove('hidden');
    itemsEl.classList.add('hidden');
    return;
  }

  emptyEl.classList.add('hidden');
  itemsEl.classList.remove('hidden');

  let total = 0;
  let html = '';

  cart.forEach((item, i) => {
    const lineTotal = Math.round(item.quantity * item.price * 100) / 100;
    total += lineTotal;
    html += `
      <tr class="border-b border-black/5">
        <td class="py-3 text-stone-dark font-medium">${item.name}</td>
        <td class="py-3 text-center">
          <input type="number" min="1" step="1" value="${item.quantity}"
                 onchange="updateCartQty(${i}, parseFloat(this.value))"
                 class="w-20 px-2 py-1 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm text-center">
          <span class="text-xs text-stone ml-1">${item.unit}</span>
        </td>
        <td class="py-3 text-right text-stone">${formatPrice(item.price)} €</td>
        <td class="py-3 text-right font-semibold text-stone-dark">${formatPrice(lineTotal)} €</td>
        <td class="py-3 text-right">
          <button onclick="removeFromCart(${i})" class="text-stone/40 hover:text-lynx-red transition-colors" title="{{ t('shop_page.cart_remove') }}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </td>
      </tr>`;
  });

  tbody.innerHTML = html;
  document.getElementById('cart-total').textContent = formatPrice(total) + ' €';
}

function showOrderForm() {
  const section = document.getElementById('order-section');
  section.classList.remove('hidden');
  section.scrollIntoView({ behavior: 'smooth', block: 'start' });

  const summaryEl = document.getElementById('order-summary');
  let total = 0;
  let html = '';
  cart.forEach(item => {
    const lineTotal = Math.round(item.quantity * item.price * 100) / 100;
    total += lineTotal;
    html += `<div class="flex justify-between text-sm py-1">
      <span class="text-stone">${item.quantity} ${item.unit} ${item.name}</span>
      <span class="font-semibold text-stone-dark">${formatPrice(lineTotal)} €</span>
    </div>`;
  });
  summaryEl.innerHTML = html;
  document.getElementById('order-total').textContent = formatPrice(total) + ' €';
}

// ===== BESTELLUNG ABSENDEN =====
document.getElementById('order-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = document.getElementById('order-submit-btn');
  const successEl = document.getElementById('order-success');
  const errorEl = document.getElementById('order-error');

  btn.disabled = true;
  btn.textContent = '...';
  successEl.classList.add('hidden');
  errorEl.classList.add('hidden');

  const formData = new FormData(this);
  const data = Object.fromEntries(formData.entries());

  data.items = cart.map(item => ({
    product_id: item.id,
    quantity: item.quantity
  }));

  try {
    const res = await fetch('/api/shop/order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    const result = await res.json();

    if (res.ok && result.success) {
      successEl.classList.remove('hidden');
      document.getElementById('order-number-display').textContent =
        '{% if locale == "de" %}Bestellnummer: {% else %}Order number: {% endif %}' + result.orderNumber;
      cart = [];
      saveCart();
      renderCart();
      this.reset();
      document.getElementById('order-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      errorEl.textContent = result.error || '{{ t("shop_page.order_error") }}';
      errorEl.classList.remove('hidden');
    }
  } catch {
    errorEl.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    btn.textContent = '{{ t("shop_page.submit_order") }} →';
  }
});

// ===== ANFRAGE-FORMULAR =====
function openInquiryForm(productName) {
  document.getElementById('inquiry-product-name').value = productName;
  document.getElementById('inquiry-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  // Reset state
  document.getElementById('inquiry-success').classList.add('hidden');
  document.getElementById('inquiry-error').classList.add('hidden');
  document.getElementById('inquiry-form').reset();
  document.getElementById('inquiry-product-name').value = productName;
}

function closeInquiryForm() {
  document.getElementById('inquiry-modal').classList.add('hidden');
  document.body.style.overflow = '';
}

document.getElementById('inquiry-form').addEventListener('submit', function(e) {
  e.preventDefault();
  const btn = document.getElementById('inquiry-submit-btn');
  const successEl = document.getElementById('inquiry-success');
  const errorEl = document.getElementById('inquiry-error');
  const form = this;

  btn.disabled = true;
  btn.textContent = '...';
  successEl.classList.add('hidden');
  errorEl.classList.add('hidden');

  const formData = new FormData(form);
  const data = Object.fromEntries(formData.entries());

  // XMLHttpRequest als robuste Alternative (kompatibel mit allen Browsern/Extensions)
  const xhr = new XMLHttpRequest();
  xhr.open('POST', '/api/shop/inquiry', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.onload = function() {
    try {
      const result = JSON.parse(xhr.responseText);
      if (xhr.status >= 200 && xhr.status < 300 && result.success) {
        successEl.classList.remove('hidden');
        errorEl.classList.add('hidden');
        form.reset();
      } else {
        errorEl.textContent = result.error || '{{ t("shop_page.order_error") }}';
        errorEl.classList.remove('hidden');
      }
    } catch(parseErr) {
      errorEl.textContent = '{{ t("shop_page.order_error") }} (Parse: ' + xhr.status + ')';
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
    btn.textContent = '{{ t("shop_page.send_inquiry") }} \u2192';
  };
  xhr.onerror = function() {
    errorEl.textContent = '{{ t("shop_page.order_error") }} (Netzwerk)';
    errorEl.classList.remove('hidden');
    btn.disabled = false;
    btn.textContent = '{{ t("shop_page.send_inquiry") }} \u2192';
  };
  xhr.send(JSON.stringify(data));
});

// Initiales Rendering
renderCart();
</script>
{% endblock %}
