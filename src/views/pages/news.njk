{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-3">{{ t('nav.news') }}</span>
    <h1 class="font-heading text-3xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('news_page.title') }}</h1>
    <p class="text-base text-white/60 max-w-2xl mx-auto mt-3">{{ t('news_page.subtitle') }}</p>
  </div>
</section>

{# ===== FILTER & NEWS GRID ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-10">

  {# Filter Tabs #}
  <div class="flex flex-wrap justify-center gap-2 mb-12">
    <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 bg-lynx-red text-white border-lynx-red" data-filter="all">{{ t('news_tabs.all') }}</button>
    <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="instagram">{{ t('news_tabs.instagram') }}</button>
    <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="linkedin">{{ t('news_tabs.linkedin') }}</button>
    <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="company">{{ t('news_tabs.company') }}</button>
  </div>

  {# News Grid #}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="news-grid">

    {# Instagram Posts #}
    {% for post in instagramPosts %}
      <div class="news-item card-hover bg-white rounded-2xl overflow-hidden shadow-md border border-black/4" data-type="instagram">
        {% if post.local_image_path or post.media_url %}
          <div class="overflow-hidden">
            <img src="{{ post.local_image_path or post.media_url }}" alt="Instagram Post" class="img-zoom w-full h-48 object-cover" loading="lazy"
                 onerror="this.parentElement.style.display='none'">
          </div>
        {% endif %}
        <div class="p-7">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block px-3 py-1 bg-gradient-to-r from-purple-500/10 to-pink-500/10 text-pink-600 text-xs font-bold rounded-full uppercase tracking-wider">Instagram</span>
          </div>
          <p class="text-stone text-sm leading-relaxed">{{ post.caption | truncate(200) }}</p>
          <div class="flex items-center justify-between mt-4">
            {% if post.permalink %}
              <a href="{{ post.permalink }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-lynx-red font-semibold text-sm hover:gap-2.5 transition-all duration-300">
                {% if locale == 'de' %}Auf Instagram ansehen{% else %}View on Instagram{% endif %} &rarr;
              </a>
            {% endif %}
            <time class="text-xs text-stone/40" datetime="{{ post.timestamp }}">{{ post.timestamp | formatDate(locale) }}</time>
          </div>
        </div>
      </div>
    {% endfor %}

    {# LinkedIn Posts #}
    {% for post in linkedinPosts %}
      <div class="news-item card-hover bg-white rounded-2xl overflow-hidden shadow-md border border-black/4" data-type="linkedin">
        {% if post.image_path %}
          <div class="overflow-hidden img-fallback-container">
            <img src="{{ post.image_path }}" alt="{{ post.title }}" class="img-zoom w-full h-48 object-cover" loading="lazy"
                 onerror="this.parentElement.innerHTML='<div class=\'h-36 bg-gradient-to-br from-[#0A66C2] to-[#004182] flex items-center justify-center\'><svg class=\'w-12 h-12 text-white/80\' viewBox=\'0 0 24 24\' fill=\'currentColor\'><path d=\'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z\'/></svg></div>'">
          </div>
        {% else %}
          <div class="h-36 bg-gradient-to-br from-[#0A66C2] to-[#004182] flex items-center justify-center">
            <svg class="w-12 h-12 text-white/80" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </div>
        {% endif %}
        <div class="p-7">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block px-3 py-1 bg-[#0A66C2]/10 text-[#0A66C2] text-xs font-bold rounded-full uppercase tracking-wider">LinkedIn</span>
            <span class="text-xs text-stone/60">{{ post.author_name }}</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-stone-dark mb-2">{{ post.title }}</h3>
          <p class="text-stone text-sm leading-relaxed">{{ post.excerpt or '' }}</p>
          <div class="flex items-center justify-between mt-4">
            <div class="flex items-center gap-3">
              {% if post.content %}
                <a href="/{{ locale }}/news/linkedin/{{ post.slug or post.id }}" class="inline-flex items-center gap-1.5 text-[#0A66C2] font-semibold text-sm hover:gap-2.5 transition-all duration-300">
                  {% if locale == 'de' %}Weiterlesen{% else %}Read more{% endif %} &rarr;
                </a>
              {% endif %}
              {% if post.linkedin_url %}
                <a href="{{ post.linkedin_url }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-stone/50 hover:text-[#0A66C2] text-sm transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                  LinkedIn
                </a>
              {% endif %}
            </div>
            <time class="text-xs text-stone/40" datetime="{{ post.published_at }}">{{ post.published_at | formatDate(locale) }}</time>
          </div>
        </div>
      </div>
    {% endfor %}

    {# Firmen-News #}
    {% for news in newsPosts %}
      <div class="news-item card-hover bg-white rounded-2xl overflow-hidden shadow-md border border-black/4" data-type="company">
        {% if news.image_path %}
          <div class="overflow-hidden">
            <img src="{{ news.image_path }}" alt="{{ news.title }}" class="img-zoom w-full h-48 object-cover" loading="lazy"
                 onerror="this.parentElement.style.display='none'">
          </div>
        {% endif %}
        <div class="p-7">
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block px-3 py-1 bg-lynx-red/8 text-lynx-red text-xs font-bold rounded-full uppercase tracking-wider">{{ t('news_tabs.company') }}</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-stone-dark mb-2">{{ news.title }}</h3>
          <p class="text-stone text-sm leading-relaxed">{{ news.excerpt or (news.content | truncate(200)) }}</p>
          <div class="flex items-center justify-end mt-4">
            <time class="text-xs text-stone/40" datetime="{{ news.published_at }}">{{ news.published_at | formatDate(locale) }}</time>
          </div>
        </div>
      </div>
    {% endfor %}

    {# Fallback wenn keine Daten #}
    {% if not instagramPosts.length and not newsPosts.length and not linkedinPosts.length %}
      <div class="col-span-full text-center py-20">
        <div class="w-20 h-20 bg-stone-light rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-stone" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-stone-dark mb-2">
          {% if locale == 'de' %}Bald gibt es hier News{% else %}News coming soon{% endif %}
        </h3>
        <p class="text-stone max-w-md mx-auto">
          {% if locale == 'de' %}Sobald die Instagram-Integration und das Admin-Panel eingerichtet sind, erscheinen hier aktuelle Beiträge.{% else %}Once the Instagram integration and admin panel are set up, current posts will appear here.{% endif %}
        </p>
        <a href="https://www.instagram.com/lynx_lining/" target="_blank" rel="noopener" class="btn-lift inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-500 text-white rounded-xl font-semibold text-sm mt-6 shadow-md">
          {% if locale == 'de' %}Folge uns auf Instagram{% else %}Follow us on Instagram{% endif %} &rarr;
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('.news-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const filter = tab.dataset.filter;
    document.querySelectorAll('.news-tab').forEach(t => {
      t.classList.remove('bg-lynx-red', 'text-white', 'border-lynx-red');
      t.classList.add('border-stone-light', 'text-stone');
    });
    tab.classList.add('bg-lynx-red', 'text-white', 'border-lynx-red');
    tab.classList.remove('border-stone-light', 'text-stone');

    document.querySelectorAll('.news-item').forEach(item => {
      if (filter === 'all' || item.dataset.type === filter) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  });
});
</script>
{% endblock %}
