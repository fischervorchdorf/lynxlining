{% extends "layouts/layout-preview.njk" %}

{% block content %}

<section class="preview-section" style="padding-top: clamp(4rem, 8vh, 6rem);">
  <div class="preview-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">

      {# Linke Spalte — Pippi flüstert ===================== #}
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-8">
          <span class="preview-rule"></span>
          <span class="preview-eyebrow">{{ t('preview.contact.eyebrow') }}</span>
        </div>

        <h1 class="preview-display" style="font-size: clamp(2.5rem, 5vw, 4rem); color: var(--color-ink); line-height: 1.05;">
          {{ t('preview.contact.headline_1') }}<br>
          <span style="font-style: italic;">{{ t('preview.contact.headline_2') }}</span>
        </h1>

        <p class="mt-10 text-base lg:text-lg leading-relaxed" style="color: var(--color-stone-dark); max-width: 28rem;">
          {{ t('preview.contact.intro') }}
        </p>

        <div class="mt-12 pt-8" style="border-top: 1px solid rgba(26,26,26,0.08); max-width: 28rem;">
          <p class="text-sm" style="color: var(--color-stone);">{{ t('preview.footer.address_1') }}</p>
          <p class="text-sm" style="color: var(--color-stone);">{{ t('preview.footer.address_2') }}</p>
          <a href="mailto:office@lynx-lining.com" class="preview-link inline-block mt-4">{{ t('preview.footer.email') }}</a>
        </div>
      </div>

      {# Rechte Spalte — der Form. Vier Felder, kein Lärm. #}
      <div class="lg:col-span-7">
        <form action="/api/preview-inquiry" method="POST" enctype="multipart/form-data"
              class="p-8 lg:p-12" style="background: var(--color-cream-deep); border-radius: 2px;">

          <div class="space-y-8">

            <div>
              <label for="name" class="block text-xs font-semibold mb-3" style="letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink);">
                {{ t('preview.contact.field_name') }}
              </label>
              <input type="text" id="name" name="name" required
                     class="w-full bg-transparent text-base pb-3 outline-none transition-colors"
                     style="border: 0; border-bottom: 1px solid rgba(26,26,26,0.25); color: var(--color-ink);"
                     onfocus="this.style.borderBottomColor='var(--color-ink)'"
                     onblur="this.style.borderBottomColor='rgba(26,26,26,0.25)'">
            </div>

            <div>
              <label for="company" class="block text-xs font-semibold mb-3" style="letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink);">
                {{ t('preview.contact.field_company') }}
              </label>
              <input type="text" id="company" name="company"
                     class="w-full bg-transparent text-base pb-3 outline-none transition-colors"
                     style="border: 0; border-bottom: 1px solid rgba(26,26,26,0.25); color: var(--color-ink);"
                     onfocus="this.style.borderBottomColor='var(--color-ink)'"
                     onblur="this.style.borderBottomColor='rgba(26,26,26,0.25)'">
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold mb-3" style="letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink);">
                {{ t('preview.contact.field_email') }}
              </label>
              <input type="email" id="email" name="email" required
                     class="w-full bg-transparent text-base pb-3 outline-none transition-colors"
                     style="border: 0; border-bottom: 1px solid rgba(26,26,26,0.25); color: var(--color-ink);"
                     onfocus="this.style.borderBottomColor='var(--color-ink)'"
                     onblur="this.style.borderBottomColor='rgba(26,26,26,0.25)'">
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold mb-3" style="letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink);">
                {{ t('preview.contact.field_message') }}
              </label>
              <textarea id="message" name="message" rows="4" required
                        class="w-full bg-transparent text-base pb-3 outline-none transition-colors resize-none"
                        style="border: 0; border-bottom: 1px solid rgba(26,26,26,0.25); color: var(--color-ink);"
                        onfocus="this.style.borderBottomColor='var(--color-ink)'"
                        onblur="this.style.borderBottomColor='rgba(26,26,26,0.25)'"></textarea>
            </div>

            <div>
              <label for="photo" class="block text-xs font-semibold mb-3" style="letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-stone);">
                {{ t('preview.contact.field_photo') }}
              </label>
              <input type="file" id="photo" name="photo" accept="image/jpeg,image/png"
                     class="block text-sm" style="color: var(--color-stone);">
            </div>

          </div>

          <div class="mt-12 flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <button type="submit" class="preview-cta" style="border: 0; cursor: pointer; font-family: var(--font-body); font-size: 1rem;">
              <span>{{ t('preview.contact.submit') }}</span>
              <span class="preview-cta-arrow">→</span>
            </button>
            <p class="text-xs leading-relaxed" style="color: var(--color-stone); max-width: 22rem;">
              {{ t('preview.contact.privacy_note') }}
            </p>
          </div>

        </form>
      </div>

    </div>
  </div>
</section>

{% endblock %}
