{% extends "layouts/main.njk" %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {% if locale == "de" %}"LYNX Lining TPU-Folie montieren – Anleitung"{% else %}"How to install LYNX Lining TPU wear protection"{% endif %},
  "description": {% if locale == "de" %}"Schritt-für-Schritt-Anleitung zur Montage von LYNX Lining Verschleißschutzfolien aus TPU per Verklebung oder Verschraubung."{% else %}"Step-by-step guide for installing LYNX Lining TPU wear protection film by adhesive bonding or mechanical screw fastening."{% endif %},
  "image": "https://lynx-lining.com/images/mounting/befestigung_schrauben.png",
  "totalTime": "PT30M",
  "supply": [
    { "@type": "HowToSupply", "name": {% if locale == "de" %}"LYNX Lining TPU-Folie (5 mm)"{% else %}"LYNX Lining TPU film (5 mm)"{% endif %} },
    { "@type": "HowToSupply", "name": {% if locale == "de" %}"Kontaktkleber oder Edelstahlschrauben"{% else %}"Contact adhesive or stainless steel screws"{% endif %} }
  ],
  "tool": [
    { "@type": "HowToTool", "name": {% if locale == "de" %}"Schleifpapier / Drahtbürste"{% else %}"Sandpaper / wire brush"{% endif %} },
    { "@type": "HowToTool", "name": {% if locale == "de" %}"Akkubohrer"{% else %}"Cordless drill"{% endif %} }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": {% if locale == "de" %}"Untergrund vorbereiten"{% else %}"Prepare the substrate"{% endif %},
      "text": {% if locale == "de" %}"Untergrund (Stahl, Beton oder Holz) von Staub, Öl und losen Teilen reinigen und aufrauen."{% else %}"Clean the substrate (steel, concrete or wood) from dust, oil and loose parts and roughen the surface."{% endif %}
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": {% if locale == "de" %}"Folie zuschneiden"{% else %}"Cut the film to size"{% endif %},
      "text": {% if locale == "de" %}"LYNX Lining auf das gewünschte Maß zuschneiden. Die Folie lässt sich mit einer Kreissäge oder Trennscheibe bearbeiten."{% else %}"Cut LYNX Lining to the desired size. The film can be processed with a circular saw or cutting disc."{% endif %}
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": {% if locale == "de" %}"Befestigung wählen: Verkleben oder Verschrauben"{% else %}"Choose fastening method: adhesive or screw"{% endif %},
      "text": {% if locale == "de" %}"Für Verklebung: Kontaktkleber auf beide Flächen auftragen, antrocknen lassen und fest andrücken. Für Verschraubung: Löcher bohren und Folie mit Senkkopfschrauben befestigen."{% else %}"For adhesive: apply contact adhesive to both surfaces, let dry until tacky and press firmly. For screwing: drill holes and secure film with countersunk screws."{% endif %}
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": {% if locale == "de" %}"Prüfen und in Betrieb nehmen"{% else %}"Check and commission"{% endif %},
      "text": {% if locale == "de" %}"Gleichmäßige Haftung bzw. festen Sitz der Schrauben prüfen. Die Folie ist sofort nach der Montage einsatzbereit."{% else %}"Check even adhesion or secure fit of screws. The film is ready for use immediately after installation."{% endif %}
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lynx-lining.com/{{ locale }}/" },
    { "@type": "ListItem", "position": 2, "name": {% if locale == "de" %}"Montage & Befestigung"{% else %}"Mounting & Fastening"{% endif %}, "item": "https://lynx-lining.com/{{ locale }}/montage" }
  ]
}
</script>
{% endblock %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-3">{{ t('nav.mounting') }}</span>
    <h1 class="font-heading text-3xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('mounting_page.title') }}</h1>
    <p class="text-base text-white/60 max-w-2xl mx-auto mt-3">{{ t('mounting_page.subtitle') }}</p>
  </div>
</section>

{# ===== BEFESTIGUNGSMETHODEN ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 -mt-8 relative z-10 pb-24">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

    {# Verklebung #}
    <div class="bg-white rounded-2xl overflow-hidden shadow-lg border border-black/4">
      <div class="bg-gradient-to-br from-[#F0EFED] to-[#E8E7E5] p-10 flex items-center justify-center min-h-[240px]">
        <div class="w-24 h-24 bg-lynx-red/10 rounded-3xl flex items-center justify-center">
          <svg class="w-14 h-14 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
        </div>
      </div>
      <div class="p-8">
        <h2 class="font-heading text-2xl font-bold text-stone-dark mb-4">{{ t('mounting_page.adhesive_title') }}</h2>
        <p class="text-stone leading-relaxed mb-6">{{ t('mounting_page.adhesive_desc') }}</p>
        <ul class="space-y-3">
          {% for feature in t('mounting_page.adhesive_features') %}
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-lynx-red/10 rounded-lg flex items-center justify-center mt-0.5">
                <svg class="w-3.5 h-3.5 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-stone-dark font-medium text-sm">{{ feature }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {# Verschraubung #}
    <div class="bg-white rounded-2xl overflow-hidden shadow-lg border border-black/4 ring-2 ring-lynx-red/20">
      <div class="relative overflow-hidden min-h-[240px]">
        <img src="/images/mounting/befestigung_schrauben.png" alt="{{ t('mounting_page.screw_title') }}" class="w-full h-full object-cover min-h-[240px]" loading="lazy">
        <span class="absolute top-4 right-4 px-4 py-1.5 bg-lynx-red text-white text-xs font-bold tracking-widest uppercase rounded-full shadow-lg">{{ t('mounting_page.screw_badge') }}</span>
      </div>
      <div class="p-8">
        <h2 class="font-heading text-2xl font-bold text-stone-dark mb-4">{{ t('mounting_page.screw_title') }}</h2>
        <p class="text-stone leading-relaxed mb-6">{{ t('mounting_page.screw_desc') }}</p>
        <ul class="space-y-3">
          {% for feature in t('mounting_page.screw_features') %}
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-lynx-red/10 rounded-lg flex items-center justify-center mt-0.5">
                <svg class="w-3.5 h-3.5 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-stone-dark font-medium text-sm">{{ feature }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

  </div>
</section>

{# ===== VORTEILE DER FLEXIBLEN BEFESTIGUNG ===== #}
<section class="bg-white py-24">
  <div class="max-w-4xl mx-auto px-6 lg:px-10">
    <div class="text-center mb-16">
      <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('mounting_page.benefits_title') }}</span>
      <h2 class="font-heading text-3xl lg:text-4xl font-extrabold text-stone-dark">{{ t('mounting_page.benefits_title') }}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {% for benefit in t('mounting_page.benefits') %}
        <div class="flex items-start gap-4 p-5 bg-[#F0EFED] rounded-xl border border-black/4">
          <div class="flex-shrink-0 w-8 h-8 bg-lynx-red/10 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-stone-dark font-medium">{{ benefit }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== KONTAKT CTA ===== #}
<div class="max-w-7xl mx-auto px-6 lg:px-10 pb-24">
  <div class="bg-gradient-to-br from-lynx-red to-lynx-red-dark rounded-[2rem] p-12 lg:p-20 text-center">
    <h2 class="font-heading text-3xl lg:text-5xl font-extrabold text-white mb-4">{{ t('contact_cta.title') }}</h2>
    <p class="text-white/85 text-lg mb-10">{{ t('contact_cta.text') }}</p>
    <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2.5 px-10 py-4 bg-white text-lynx-red rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(0,0,0,0.15)]">
      {{ t('contact_cta.button') }} &rarr;
    </a>
  </div>
</div>

{% endblock %}
