{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-3">{{ t('nav.contact') }}</span>
    <h1 class="font-heading text-3xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('contact_page.title') }}</h1>
    <p class="text-base text-white/60 max-w-2xl mx-auto mt-3">{{ t('contact_page.subtitle') }}</p>
  </div>
</section>

{# ===== KONTAKT GRID ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 -mt-8 relative z-10 pb-24">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">

    {# Kontaktinformationen #}
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl p-8 shadow-lg border border-black/4">
        <h2 class="font-heading text-xl font-bold text-stone-dark mb-6">{{ t('contact_page.info_title') }}</h2>

        <div class="space-y-6">
          {# Adresse #}
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-lynx-red/8 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-stone-dark text-sm mb-1">{{ t('contact_page.address') }}</h3>
              <p class="text-stone text-sm">LYNX Lining</p>
              <p class="text-stone text-sm">Ing. Martin F. Heidecker</p>
              <p class="text-stone text-sm">Schillerstraße 13</p>
              <p class="text-stone text-sm">4020 Linz, Austria</p>
            </div>
          </div>

          {# E-Mail #}
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-lynx-red/8 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-stone-dark text-sm mb-1">{{ t('contact_page.email') }}</h3>
              <a href="mailto:office@lynx-lining.com" class="text-lynx-red text-sm hover:underline">office@lynx-lining.com</a>
            </div>
          </div>

          {# Geschäftszeiten #}
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-lynx-red/8 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-stone-dark text-sm mb-1">{{ t('contact_page.hours') }}</h3>
              <p class="text-stone text-sm">{{ t('contact_page.hours_weekday') }}</p>
              <p class="text-stone text-sm">{{ t('contact_page.hours_weekend') }}</p>
            </div>
          </div>
        </div>
      </div>

      {# Social / Instagram #}
      <div class="bg-gradient-to-br from-purple-600 to-pink-500 rounded-2xl p-8 text-white">
        <h3 class="font-heading font-bold text-lg mb-3">Instagram</h3>
        <p class="text-white/85 text-sm mb-4">
          {% if locale == 'de' %}Folgen Sie uns auf Instagram für aktuelle Projekte und Einblicke.{% else %}Follow us on Instagram for current projects and insights.{% endif %}
        </p>
        <a href="https://www.instagram.com/lynx_lining/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/20 rounded-xl font-semibold text-sm hover:bg-white/30 transition-colors">
          @lynx_lining &rarr;
        </a>
      </div>
    </div>

    {# Kontaktformular #}
    <div class="lg:col-span-3">
      <div class="bg-white rounded-2xl p-8 lg:p-10 shadow-lg border border-black/4">
        <h2 class="font-heading text-xl font-bold text-stone-dark mb-6">{{ t('contact_page.form_title') }}</h2>

        <div id="contact-success" class="hidden mb-6 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm">
          {{ t('contact_form.success') }}
        </div>
        <div id="contact-error" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
          {{ t('contact_form.error') }}
        </div>

        <form id="contact-form" class="space-y-5">
          {# Honeypot #}
          <div class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.name') }} <span class="text-lynx-red">*</span></label>
              <input type="text" id="name" name="name" required
                     class="w-full px-4 py-3 bg-[#F0EFED] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none transition-all">
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.email') }} <span class="text-lynx-red">*</span></label>
              <input type="email" id="email" name="email" required
                     class="w-full px-4 py-3 bg-[#F0EFED] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none transition-all">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="phone" class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.phone') }}</label>
              <input type="tel" id="phone" name="phone"
                     class="w-full px-4 py-3 bg-[#F0EFED] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none transition-all">
            </div>
            <div>
              <label for="subject" class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.subject') }} <span class="text-lynx-red">*</span></label>
              <input type="text" id="subject" name="subject" required
                     class="w-full px-4 py-3 bg-[#F0EFED] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none transition-all">
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-stone-dark mb-2">{{ t('contact_form.message') }} <span class="text-lynx-red">*</span></label>
            <textarea id="message" name="message" rows="6" required
                      class="w-full px-4 py-3 bg-[#F0EFED] border border-black/8 rounded-xl text-stone-dark focus:ring-2 focus:ring-lynx-red/30 focus:border-lynx-red outline-none transition-all resize-none"></textarea>
          </div>

          {# DSGVO Datenschutz-Checkbox #}
          <div class="flex items-start gap-3">
            <input type="checkbox" id="privacy-consent" name="privacy_consent" required
                   class="mt-1 w-4 h-4 accent-lynx-red rounded shrink-0">
            <label for="privacy-consent" class="text-sm text-stone leading-relaxed">
              {{ t('contact_form.privacy_text') }}
              <a href="/{{ locale }}/datenschutz" class="text-lynx-red hover:underline" target="_blank">{{ t('contact_form.privacy_link') }}</a>. <span class="text-lynx-red">*</span>
            </label>
          </div>

          <button type="submit" id="submit-btn" class="btn-lift w-full md:w-auto px-10 py-4 bg-lynx-red text-white rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(214,69,69,0.35)] hover:bg-lynx-red-dark hover:shadow-[0_12px_40px_rgba(214,69,69,0.45)] transition-all">
            {{ t('contact_form.submit') }} &rarr;
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
document.getElementById('contact-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  const successEl = document.getElementById('contact-success');
  const errorEl = document.getElementById('contact-error');

  btn.disabled = true;
  btn.textContent = '...';
  successEl.classList.add('hidden');
  errorEl.classList.add('hidden');

  const formData = new FormData(this);
  const data = Object.fromEntries(formData.entries());

  try {
    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      successEl.classList.remove('hidden');
      this.reset();
    } else {
      const result = await res.json();
      errorEl.textContent = result.error || '{{ t("contact_form.error") }}';
      errorEl.classList.remove('hidden');
    }
  } catch {
    errorEl.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    btn.textContent = '{{ t("contact_form.submit") }} →';
  }
});
</script>
{% endblock %}
