{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('nav.products') }}</span>
    <h1 class="font-heading text-4xl lg:text-6xl font-extrabold text-white leading-tight">{{ t('products_page.title') }}</h1>
    <p class="text-lg text-white/60 max-w-2xl mx-auto mt-4">{{ t('products_page.subtitle') }}</p>
  </div>
</section>

{# ===== PRODUKTE GRID ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 -mt-16 relative z-10 pb-24">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    {% if products.length %}
      {% for prod in products %}
        <div class="group bg-white rounded-2xl overflow-hidden shadow-lg border border-black/4 hover:-translate-y-2 transition-all duration-300">
          <div class="overflow-hidden">
            <img src="{{ prod.image_path }}" alt="{{ prod.title }}" class="img-zoom w-full h-64 object-cover" loading="lazy">
          </div>
          <div class="p-8">
            <span class="inline-block px-3 py-1 bg-lynx-red/8 text-lynx-red text-xs font-bold rounded-full uppercase tracking-wider mb-4">{{ prod.subtitle }}</span>
            <h2 class="font-heading text-2xl font-bold text-stone-dark mb-3">{{ prod.title }}</h2>
            <p class="text-stone leading-relaxed mb-6">{{ prod.description }}</p>
            <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2 px-6 py-3 bg-lynx-red text-white rounded-xl font-semibold text-sm shadow-md hover:bg-lynx-red-dark">
              {{ t('products_page.cta') }} &rarr;
            </a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% set staticProducts = [
        { title: "LYNX Lining Standard", subtitle: "Der Allrounder", desc: "Unser Standardprodukt für vielfältige Anwendungen im Verschleißschutz. Ideal für moderate Beanspruchung.", img: "/images/products/produkt.JPG" },
        { title: "LYNX Lining Comfort", subtitle: "Maximaler Komfort", desc: "Erweiterte Schalldämpfung und Vibrationsreduktion. Perfekt für lärmempfindliche Umgebungen.", img: "/images/products/produkt.JPG" },
        { title: "LYNX Lining Ultra", subtitle: "Extreme Belastung", desc: "Für extremste Beanspruchung im Bergbau und bei hoch abrasiven Materialien. Maximale Lebensdauer.", img: "/images/products/6675642.jpg" }
      ] %}
      {% for prod in staticProducts %}
        <div class="group bg-white rounded-2xl overflow-hidden shadow-lg border border-black/4 hover:-translate-y-2 transition-all duration-300">
          <div class="overflow-hidden">
            <img src="{{ prod.img }}" alt="{{ prod.title }}" class="img-zoom w-full h-64 object-cover" loading="lazy">
          </div>
          <div class="p-8">
            <span class="inline-block px-3 py-1 bg-lynx-red/8 text-lynx-red text-xs font-bold rounded-full uppercase tracking-wider mb-4">{{ prod.subtitle }}</span>
            <h2 class="font-heading text-2xl font-bold text-stone-dark mb-3">{{ prod.title }}</h2>
            <p class="text-stone leading-relaxed mb-6">{{ prod.desc }}</p>
            <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2 px-6 py-3 bg-lynx-red text-white rounded-xl font-semibold text-sm shadow-md hover:bg-lynx-red-dark">
              {{ t('products_page.cta') }} &rarr;
            </a>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{# ===== TECHNISCHE DATEN ===== #}
<section class="bg-white py-24">
  <div class="max-w-5xl mx-auto px-6 lg:px-10">
    <div class="text-center mb-16">
      <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('products_page.specs') }}</span>
      <h2 class="font-heading text-3xl lg:text-4xl font-extrabold text-stone-dark">{{ t('products_page.specs') }}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-[#FAFAF9] rounded-2xl p-8 border border-black/4">
        <div class="w-12 h-12 bg-lynx-red/8 rounded-xl flex items-center justify-center text-lynx-red text-xl mb-4">📐</div>
        <h3 class="font-heading font-bold text-stone-dark mb-2">{{ t('products_page.thickness') }}</h3>
        <p class="text-stone">{{ t('products_page.thickness_value') }}</p>
      </div>
      <div class="bg-[#FAFAF9] rounded-2xl p-8 border border-black/4">
        <div class="w-12 h-12 bg-lynx-red/8 rounded-xl flex items-center justify-center text-lynx-red text-xl mb-4">📏</div>
        <h3 class="font-heading font-bold text-stone-dark mb-2">{{ t('products_page.width') }}</h3>
        <p class="text-stone">{{ t('products_page.width_value') }}</p>
      </div>
      <div class="bg-[#FAFAF9] rounded-2xl p-8 border border-black/4">
        <div class="w-12 h-12 bg-lynx-red/8 rounded-xl flex items-center justify-center text-lynx-red text-xl mb-4">📦</div>
        <h3 class="font-heading font-bold text-stone-dark mb-2">{{ t('products_page.formats') }}</h3>
        <p class="text-stone">{{ t('products_page.formats_value') }}</p>
      </div>
      <div class="bg-[#FAFAF9] rounded-2xl p-8 border border-black/4">
        <div class="w-12 h-12 bg-lynx-red/8 rounded-xl flex items-center justify-center text-lynx-red text-xl mb-4">🎨</div>
        <h3 class="font-heading font-bold text-stone-dark mb-2">{{ t('products_page.colors') }}</h3>
        <p class="text-stone">{{ t('products_page.colors_value') }}</p>
        <p class="text-sm text-stone/70 mt-2">{{ t('products_page.custom_colors') }}</p>
      </div>
    </div>
  </div>
</section>

{# ===== LEBENSDAUER VERGLEICH ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
  <div class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] rounded-[2rem] p-10 lg:p-20 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div>
      <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">30x</span>
      <h2 class="font-heading text-3xl lg:text-4xl font-extrabold text-white mb-4">
        {% if locale == 'de' %}Lebensdauer-Vergleich{% else %}Service Life Comparison{% endif %}
      </h2>
      <p class="text-white/70 leading-relaxed mb-8">
        {% if locale == 'de' %}LYNX Lining hält bis zu 30x länger als herkömmliche Verschleißschutzmaterialien. Das bedeutet weniger Stillstandzeiten, geringere Wartungskosten und höhere Produktivität.{% else %}LYNX Lining lasts up to 30x longer than conventional wear protection materials. This means less downtime, lower maintenance costs and higher productivity.{% endif %}
      </p>
      <div class="space-y-4">
        <div>
          <div class="flex justify-between text-sm text-white/80 mb-1">
            <span>{% if locale == 'de' %}Herkömmlich{% else %}Conventional{% endif %}</span>
            <span>~3 {% if locale == 'de' %}Monate{% else %}months{% endif %}</span>
          </div>
          <div class="w-full bg-white/10 rounded-full h-3"><div class="bg-white/30 h-3 rounded-full" style="width:3.3%"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-sm text-white/80 mb-1">
            <span>LYNX Lining</span>
            <span>~90 {% if locale == 'de' %}Monate{% else %}months{% endif %}</span>
          </div>
          <div class="w-full bg-white/10 rounded-full h-3"><div class="bg-lynx-red h-3 rounded-full" style="width:100%"></div></div>
        </div>
      </div>
    </div>
    <div class="flex justify-center">
      <img src="/images/products/lebensdauer.JPG" alt="Lebensdauer Vergleich" class="rounded-2xl shadow-2xl max-h-80 object-cover">
    </div>
  </div>
</section>

{# ===== KONTAKT CTA ===== #}
<div class="max-w-7xl mx-auto px-6 lg:px-10 pb-24">
  <div class="bg-gradient-to-br from-lynx-red to-lynx-red-dark rounded-[2rem] p-12 lg:p-20 text-center">
    <h2 class="font-heading text-3xl lg:text-5xl font-extrabold text-white mb-4">{{ t('contact_cta.title') }}</h2>
    <p class="text-white/85 text-lg mb-10">{{ t('contact_cta.text') }}</p>
    <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2.5 px-10 py-4 bg-white text-lynx-red rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(0,0,0,0.15)]">
      {{ t('contact_cta.button') }} &rarr;
    </a>
  </div>
</div>

{% endblock %}
