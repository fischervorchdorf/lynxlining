{% extends "layouts/main.njk" %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": {% if locale == "de" %}"Über uns – Die Geschichte von LYNX Lining"{% else %}"About us – The story of LYNX Lining"{% endif %},
  "url": "https://lynx-lining.com/{{ locale }}/ueber-uns",
  "inLanguage": {% if locale == "de" %}"de-AT"{% else %}"en"{% endif %},
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://lynx-lining.com/#organization",
    "name": "LYNX Lining",
    "foundingDate": "2020",
    "foundingLocation": { "@type": "Place", "name": "Linz, Österreich" },
    "founder": { "@type": "Person", "name": "Ing. Martin F. Heidecker" }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lynx-lining.com/{{ locale }}/" },
    { "@type": "ListItem", "position": 2, "name": {% if locale == "de" %}"Über uns"{% else %}"About us"{% endif %}, "item": "https://lynx-lining.com/{{ locale }}/ueber-uns" }
  ]
}
</script>
{% endblock %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-3">{{ t('nav.about') }}</span>
    <h1 class="font-heading text-3xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('about_page.title') }}</h1>
    <p class="text-base text-white/60 max-w-2xl mx-auto mt-3">{{ t('about_page.subtitle') }}</p>
  </div>
</section>

{# ===== MEILENSTEINE ===== #}
<section class="max-w-3xl mx-auto px-6 lg:px-10 py-20">
  <div class="text-center mb-14">
    <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full">{{ t('about_page.story_label') }}</span>
  </div>
  <ol class="relative border-l-2 border-lynx-red/20 ml-4">
    {% for m in t('about_page.milestones') %}
      <li class="mb-12 ml-8 last:mb-0">
        <span class="absolute -left-[9px] mt-1.5 block w-4 h-4 bg-lynx-red rounded-full ring-4 ring-white"></span>
        <div class="text-xs font-bold tracking-widest uppercase text-lynx-red mb-1">{{ m.year }}</div>
        <h2 class="font-heading text-xl font-bold text-stone-dark mb-2">{{ m.title }}</h2>
        <p class="text-stone leading-relaxed">{{ m.text }}</p>
      </li>
    {% endfor %}
  </ol>
</section>

{# ===== FAKTEN ===== #}
<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="text-center mb-14">
      <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('about_page.facts_label') }}</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% for fact in t('about_page.facts') %}
        <div class="p-8 bg-[#F0EFED] rounded-2xl border border-black/4">
          <h3 class="font-heading text-lg font-bold text-stone-dark mb-3">{{ fact.title }}</h3>
          <p class="text-stone text-sm leading-relaxed">{{ fact.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== KONTAKT CTA ===== #}
<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
  <div class="bg-gradient-to-br from-lynx-red to-lynx-red-dark rounded-[2rem] p-12 lg:p-20 text-center">
    <h2 class="font-heading text-3xl lg:text-5xl font-extrabold text-white mb-4">{{ t('contact_cta.title') }}</h2>
    <p class="text-white/85 text-lg mb-10">{{ t('contact_cta.text') }}</p>
    <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2.5 px-10 py-4 bg-white text-lynx-red rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(0,0,0,0.15)]">
      {{ t('contact_cta.button') }} &rarr;
    </a>
  </div>
</div>

{% endblock %}
