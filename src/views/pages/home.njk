{% extends "layouts/main.njk" %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in t('faq.items') %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.a | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endblock %}

{% block content %}

{# ===== HERO SECTION ===== #}
<section class="relative min-h-[85vh] flex items-center bg-gradient-to-br from-stone-dark to-[#1a1c1e] overflow-hidden">
  <div class="absolute inset-0 bg-[url('/images/hero/hero_background.jpg')] bg-cover bg-center"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-stone-dark/95 via-stone-dark/70 via-50% to-transparent"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <div>
      <h1 class="font-heading font-extrabold text-white leading-tight">
        <span class="text-lynx-red text-5xl lg:text-7xl block">{{ t('hero.title') }}</span>
        <span class="text-3xl lg:text-5xl mt-2 block">{{ t('hero.subtitle') }}</span>
      </h1>
      <p class="text-xl text-white/70 font-light mt-6 leading-relaxed">{{ t('hero.text') }}</p>
      <p class="text-base text-white/50 mt-4 max-w-lg">{{ t('hero.description') }}</p>

      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/{{ locale }}/produkte" class="btn-lift inline-flex items-center gap-2.5 px-8 py-4 bg-lynx-red text-white rounded-xl font-semibold text-base shadow-[0_8px_30px_rgba(214,69,69,0.35)] hover:bg-lynx-red-dark hover:shadow-[0_12px_40px_rgba(214,69,69,0.45)]">
          {{ t('hero.cta_primary') }} &rarr;
        </a>
        <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2.5 px-8 py-4 border-2 border-white/30 text-white rounded-xl font-medium text-base hover:border-white hover:bg-white/8">
          {{ t('hero.cta_secondary') }}
        </a>
      </div>

      <div class="flex flex-wrap gap-4 mt-10">
        <div class="flex items-center gap-2 px-5 py-2.5 bg-white/8 border border-white/12 rounded-full text-white/80 text-sm font-medium">
          ✅ {{ t('hero.badge_lifetime') }}
        </div>
        <div class="flex items-center gap-2 px-5 py-2.5 bg-white/8 border border-white/12 rounded-full text-white/80 text-sm font-medium">
          ♻️ {{ t('hero.badge_recyclable') }}
        </div>
      </div>
    </div>

    <div class="hidden lg:flex flex-col items-end gap-6">
      <div class="bg-white p-5 rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.3)] text-center">
        <img src="/images/icons/made_in_austria.png" alt="Made in Austria" class="w-28 h-auto">
      </div>
    </div>
  </div>
</section>

{# ===== STATS BAR ===== #}
<div class="max-w-5xl mx-auto -mt-14 relative z-10 bg-white rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.1)] grid grid-cols-2 lg:grid-cols-4 gap-8 p-10 text-center">
  <div>
    <div class="font-heading text-4xl font-extrabold text-lynx-red">30x</div>
    <div class="text-sm text-stone mt-1 font-medium">{{ t('stats.lifetime') }}</div>
  </div>
  <div>
    <div class="font-heading text-4xl font-extrabold text-lynx-red">100%</div>
    <div class="text-sm text-stone mt-1 font-medium">{{ t('stats.recyclable') }}</div>
  </div>
  <div>
    <div class="font-heading text-4xl font-extrabold text-lynx-red">6+</div>
    <div class="text-sm text-stone mt-1 font-medium">{{ t('stats.industries') }}</div>
  </div>
  <div>
    <div class="text-4xl">🇦🇹</div>
    <div class="text-sm text-stone mt-1 font-medium">{{ t('stats.austria') }}</div>
  </div>
</div>

{# ===== ANWENDUNGEN ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
  <div class="text-center mb-16">
    <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('sections.applications') }}</span>
    <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-stone-dark leading-tight">{{ t('sections.applications_title') }}</h2>
    <p class="text-lg text-stone max-w-2xl mx-auto mt-4">{{ t('sections.applications_subtitle') }}</p>
    <p class="text-base text-stone max-w-3xl mx-auto mt-3">{{ t('sections.applications_intro') }}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% if applications.length %}
      {% for app in applications %}
        <div class="group card-hover bg-white rounded-2xl overflow-hidden shadow-md border border-black/4">
          <div class="overflow-hidden">
            <img src="{{ app.image_path }}" alt="{{ app.title }}" class="img-zoom w-full h-56 object-cover" loading="lazy">
          </div>
          <div class="p-7">
            <h3 class="font-heading text-lg font-bold text-stone-dark mb-3">{{ app.title }}</h3>
            <p class="text-sm text-stone leading-relaxed">{{ app.description }}</p>
            <a href="/{{ locale }}/anwendungen#{{ app.slug }}" class="inline-flex items-center gap-1.5 text-lynx-red font-semibold text-sm mt-4 hover:gap-2.5 transition-all duration-300">
              {{ t('sections.details') }} &rarr;
            </a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {# Statische Fallback-Daten wenn DB nicht verfügbar #}
      {% set staticApps = [
        { title: "Schüttgutaufbereitung", desc: "Auskleidung von Trichtern, Verschleißschutz bei Übergabepunkten, Abdichtungen bei Förderbändern, Staubkapselung", img: "/images/applications/application_schuettgut.jpg" },
        { title: "Bergbau", desc: "Aufgabebunker, hochabrasive, feuchte und klebrige Materialien", img: "/images/applications/application_bergbau.jpg" },
        { title: "Industrie", desc: "Verschleißauskleidung für feste, staubförmige und flüssige Materialförderung, Schleifstaubabsaugungen, Förderbänder mit Aufpanzerung, Oberflächenschutz", img: "/images/applications/application_industrie1.jpg" },
        { title: "Maschinen- und Anlagenbau", desc: "Übergabepunkte und Verkleidungen in der Betonproduktion, Aufgabetrichter bei verschiedenen Recyclinganlagen", img: "/images/applications/application_maschinen.jpg" },
        { title: "Recycling & Aufbereitung", desc: "Recycling und Aufbereitung von Bauschutt, Gesteinsmaterial für Kiesproduktion und andere organische Stoffe", img: "/images/applications/application_recycling.jpg" },
        { title: "Schienenfahrzeuge & Transportwirtschaft", desc: "Verschleißauskleidung für Schienenbearbeitungszüge (Schotterbunker und Silos), Auskleidungen für Kippermulden und Kehrmaschinen", img: "/images/applications/application_schienen.jpg" }
      ] %}
      {% for app in staticApps %}
        <div class="group card-hover bg-white rounded-2xl overflow-hidden shadow-md border border-black/4">
          <div class="overflow-hidden">
            <img src="{{ app.img }}" alt="{{ app.title }}" class="img-zoom w-full h-56 object-cover" loading="lazy">
          </div>
          <div class="p-7">
            <h3 class="font-heading text-lg font-bold text-stone-dark mb-3">{{ app.title }}</h3>
            <p class="text-sm text-stone leading-relaxed">{{ app.desc }}</p>
            <a href="#" class="inline-flex items-center gap-1.5 text-lynx-red font-semibold text-sm mt-4 hover:gap-2.5 transition-all duration-300">
              {{ t('sections.details') }} &rarr;
            </a>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{# ===== VORTEILE ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
  <div class="text-center mb-16">
    <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('sections.advantages') }}</span>
    <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-stone-dark leading-tight">{{ t('sections.advantages_title') }}</h2>
    <p class="text-lg text-stone max-w-2xl mx-auto mt-4">{{ t('sections.advantages_subtitle') }}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% set staticAdvantages = [
      { icon: "🛡️", title: "Verschleißfest", desc: "Unsere LYNX Lining Produkte überzeugen durch eine enorme Verschleißfestigkeit, welche die Lebensdauer und die Kosteneinsparungen jeweils positiv verstärken." },
      { icon: "🔇", title: "Schalldämpfung", desc: "Durch Verwendung unserer LYNX Lining Produkte können bestehende Lärmemissionen um bis zu 21 DB reduziert werden." },
      { icon: "🌸", title: "Anti-Haft", desc: "Kein Verkleben mehr von Förderrinnen oder LKW-Kippern. Die Antihafteigenschaft ist auch bekannt als ‚Lotuseffekt'." },
      { icon: "📈", title: "Vibrationsreduktion", desc: "Vibrationen werden durch die Beschichtung mit LYNX Lining Produkten deutlich vermindert. Dadurch hält Ihre Produktionsausrüstung um ein vielfaches länger." },
      { icon: "♻️", title: "100% recyclebar", desc: "Unsere Produkte werden in Österreich mit höchster Qualität produziert und sind zu 100 % recyclebar, was einen enormen Vorteil für unsere Umwelt darstellt." },
      { icon: "🇦🇹", title: "Made in Austria", desc: "Höchste Qualität durch Produktion in Österreich." }
    ] %}
    {% set advList = advantages if advantages.length else staticAdvantages %}

    {% for adv in advList %}
      <div class="adv-card relative overflow-hidden card-hover bg-white rounded-2xl p-10 text-center shadow-md border border-black/4">
        <div class="w-[72px] h-[72px] bg-lynx-red/8 rounded-2xl flex items-center justify-center mx-auto mb-6 text-3xl transition-all duration-300 group-hover:bg-lynx-red group-hover:text-white group-hover:scale-110">
          {% if adv.icon_path %}
            <img src="{{ adv.icon_path }}" alt="{{ adv.title }}" class="w-10 h-10">
          {% else %}
            {{ adv.icon }}
          {% endif %}
        </div>
        <h3 class="font-heading text-lg font-bold text-stone-dark mb-3">{{ adv.title }}</h3>
        <p class="text-sm text-stone leading-relaxed">{{ adv.desc or adv.description }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{# ===== LYNX LINING STEHT FÜR ===== #}
<section class="bg-[#F0EFED] py-24">
  <div class="max-w-5xl mx-auto px-6 lg:px-10 text-center">
    <h2 class="font-heading text-2xl lg:text-3xl font-extrabold text-stone-dark mb-4">{{ t('sections.revolution_text') }}</h2>
    <img src="/images/logo/logo_lynx_large.png" alt="LYNX Lining" class="max-w-sm mx-auto my-10" loading="lazy">
    <p class="text-lynx-red font-heading font-bold text-xl mb-6">{{ t('sections.stands_for') }}</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
      {% set features = t('sections.stands_for_list') %}
      {% if features %}
        {% for feat in features %}
          <div class="flex items-center gap-2 text-sm text-stone-dark font-medium">
            <span class="w-2 h-2 bg-lynx-red rounded-full shrink-0"></span>
            {{ feat }}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{# ===== LEBENSDAUER ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-24">
  <div class="text-center mb-16">
    <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('sections.lifetime') }}</span>
    <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-stone-dark leading-tight">
      <span class="text-lynx-red">LYNX LINING</span> {{ t('sections.lifetime_title') }}
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
    <div class="text-center">
      <div class="bg-white rounded-2xl shadow-md border border-black/4 overflow-hidden">
        <img src="/images/products/kipper_nach_30_monaten.JPG" alt="Kipper mit LYNX Lining" class="w-full h-auto" loading="lazy">
      </div>
      <p class="text-sm text-stone italic mt-4">{{ t('sections.lifetime_caption') }}</p>
    </div>
    <div>
      <div class="bg-white rounded-2xl shadow-md border border-black/4 p-4">
        <img src="/images/products/lebensdauer.JPG" alt="TPU Lebensdauer Vergleich" class="w-full h-auto rounded-lg" loading="lazy">
      </div>
    </div>
  </div>
</section>

{# ===== TESTIMONIALS ===== #}
<div class="max-w-7xl mx-auto px-6 lg:px-10 my-20">
  <div class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] rounded-[2rem] p-10 lg:p-20">
    <div class="text-center mb-16">
      <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">{{ t('sections.references') }}</span>
      <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('sections.references_title') }}</h2>
      <p class="text-lg text-white/60 max-w-2xl mx-auto mt-4">{{ t('sections.references_subtitle') }}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% set staticTestimonials = [
        { name: "Johann Arthofer", role: "Arthofer Bau GmbH", initials: "JA", quote: "Seit wir LYNX Lining einsetzen, haben sich unsere Standzeiten dramatisch verbessert. Die Investition hat sich innerhalb weniger Monate amortisiert." },
        { name: "Andreas Grabner", role: "Grabner Recycling", initials: "AG", quote: "Die Vibrationsreduktion und Schalldämpfung durch LYNX Lining ist beeindruckend. Unsere Mitarbeiter schätzen die reduzierte Lärmbelastung." },
        { name: "Rudolf Mandorfer", role: "Mandorfer Bau GmbH", initials: "RM", quote: "Die Anti-Haft-Eigenschaften sind herausragend. Materialanbackungen gehören der Vergangenheit an, was unsere Effizienz enorm gesteigert hat." }
      ] %}
      {% set testList = testimonials if testimonials.length else staticTestimonials %}

      {% for test in testList %}
        <div class="bg-white/6 border border-white/8 rounded-2xl p-9 hover:bg-white/10 hover:-translate-y-1 transition-all duration-300">
          <div class="text-amber-400 text-lg tracking-widest mb-5">★★★★★</div>
          <p class="text-white/85 text-[15px] leading-relaxed mb-6 italic">"{{ test.quote }}"</p>
          <div class="flex items-center gap-3.5">
            {% if test.photo_path %}
              <img src="{{ test.photo_path }}" alt="{{ test.name }}" class="w-12 h-12 rounded-full object-cover">
            {% else %}
              <div class="w-12 h-12 rounded-full bg-lynx-red flex items-center justify-center text-white font-bold text-lg">
                {{ test.initials or test.name[0] }}
              </div>
            {% endif %}
            <div>
              <div class="text-white font-semibold text-[15px]">{{ test.name }}</div>
              <div class="text-white/50 text-sm">{{ test.role or test.company }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{# ===== NEWS SECTION ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 py-12">
  <div class="bg-white rounded-[2rem] p-10 lg:p-16 shadow-md">
    <div class="text-center mb-12">
      <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">📰 {{ t('sections.news') }}</span>
      <h2 class="font-heading text-4xl lg:text-5xl font-extrabold text-stone-dark leading-tight">{{ t('sections.news_title') }}</h2>
      <p class="text-lg text-stone max-w-2xl mx-auto mt-4">{{ t('sections.news_subtitle') }}</p>
    </div>

    <div class="flex justify-center gap-2 mb-12">
      <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 bg-lynx-red text-white border-lynx-red" data-filter="all">{{ t('news_tabs.all') }}</button>
      <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="instagram">{{ t('news_tabs.instagram') }}</button>
      <button class="news-tab px-6 py-2.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 border-stone-light text-stone hover:border-lynx-red hover:text-lynx-red" data-filter="company">{{ t('news_tabs.company') }}</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="news-grid">
      {# Instagram Posts #}
      {% for post in instagramPosts %}
        <div class="news-item card-hover rounded-2xl overflow-hidden bg-[#F0EFED] border border-black/6" data-type="instagram">
          {% if post.local_image_path %}
            <img src="{{ post.local_image_path }}" alt="Instagram Post" class="w-full h-60 object-cover" loading="lazy">
          {% endif %}
          <div class="p-6">
            <span class="inline-block px-3 py-1 bg-lynx-red/8 text-lynx-red text-xs font-bold rounded-full uppercase tracking-wider mb-3">📷 Instagram</span>
            <p class="text-sm text-stone leading-relaxed">{{ post.caption | truncate(120) }}</p>
            <div class="text-xs text-stone-medium mt-3">{{ post.timestamp }}</div>
          </div>
        </div>
      {% endfor %}

      {# Firmen-News #}
      {% for news in newsPosts %}
        <div class="news-item card-hover rounded-2xl overflow-hidden bg-[#F0EFED] border border-black/6" data-type="company">
          {% if news.image_path %}
            <img src="{{ news.image_path }}" alt="{{ news.title }}" class="w-full h-60 object-cover" loading="lazy">
          {% endif %}
          <div class="p-6">
            <span class="inline-block px-3 py-1 bg-lynx-red/8 text-lynx-red text-xs font-bold rounded-full uppercase tracking-wider mb-3">📰 {{ t('news_tabs.company') }}</span>
            <h3 class="font-heading text-base font-bold text-stone-dark mb-2">{{ news.title }}</h3>
            <p class="text-sm text-stone leading-relaxed">{{ news.excerpt }}</p>
            <div class="text-xs text-stone-medium mt-3">{{ news.published_at }}</div>
          </div>
        </div>
      {% endfor %}

      {# Fallback wenn keine Daten #}
      {% if not instagramPosts.length and not newsPosts.length %}
        <div class="col-span-full text-center py-12 text-stone">
          <p class="text-lg">News werden geladen...</p>
          <p class="text-sm mt-2">Sobald die Instagram-Integration und das Admin-Panel eingerichtet sind, erscheinen hier aktuelle Beiträge.</p>
        </div>
      {% endif %}
    </div>

    <div class="text-center mt-10">
      <a href="/{{ locale }}/news" class="btn-lift inline-flex items-center gap-2 px-8 py-3 border-2 border-lynx-red text-lynx-red rounded-xl font-semibold text-sm hover:bg-lynx-red hover:text-white transition-colors duration-300">
        {{ t('sections.view_more') }} &rarr;
      </a>
    </div>
  </div>
</section>

{# ===== FAQ ===== #}
<section class="bg-white py-20 lg:py-28" id="faq" itemscope itemtype="https://schema.org/FAQPage">
  <div class="max-w-3xl mx-auto px-6 lg:px-10">
    <div class="text-center mb-14">
      <span class="inline-block px-5 py-2 bg-lynx-red/8 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-5">FAQ</span>
      <h2 class="font-heading text-3xl lg:text-4xl font-extrabold text-stone-dark mb-4">{{ t('faq.title') }}</h2>
      <p class="text-stone text-base">{{ t('faq.subtitle') }}</p>
    </div>
    <div class="space-y-3">
      {% for item in t('faq.items') %}
      <div class="border border-black/8 rounded-2xl overflow-hidden" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <details class="group">
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none select-none hover:bg-[#F8F7F6] transition-colors">
            <span class="font-heading font-semibold text-stone-dark text-base" itemprop="name">{{ item.q }}</span>
            <svg class="w-5 h-5 text-lynx-red shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-6 pb-6 text-stone leading-relaxed text-sm" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text">{{ item.a }}</p>
          </div>
        </details>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== KONTAKT CTA ===== #}
<div class="max-w-7xl mx-auto px-6 lg:px-10 py-12">
  <div class="bg-gradient-to-br from-lynx-red to-lynx-red-dark rounded-[2rem] p-12 lg:p-20 text-center">
    <h2 class="font-heading text-3xl lg:text-5xl font-extrabold text-white mb-4">{{ t('contact_cta.title') }}</h2>
    <p class="text-white/85 text-lg mb-10">{{ t('contact_cta.text') }}</p>
    <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2.5 px-10 py-4 bg-white text-lynx-red rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(0,0,0,0.15)] hover:shadow-[0_12px_40px_rgba(0,0,0,0.2)]">
      {{ t('contact_cta.button') }} &rarr;
    </a>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
// News Filter Tabs
document.querySelectorAll('.news-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const filter = tab.dataset.filter;
    document.querySelectorAll('.news-tab').forEach(t => {
      t.classList.remove('bg-lynx-red', 'text-white', 'border-lynx-red');
      t.classList.add('border-stone-light', 'text-stone');
    });
    tab.classList.add('bg-lynx-red', 'text-white', 'border-lynx-red');
    tab.classList.remove('border-stone-light', 'text-stone');

    document.querySelectorAll('.news-item').forEach(item => {
      if (filter === 'all' || item.dataset.type === filter) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  });
});
