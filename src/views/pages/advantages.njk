{% extends "layouts/main.njk" %}

{% block content %}

{# ===== HERO ===== #}
<section class="bg-gradient-to-br from-stone-dark to-[#1a1c1e] py-12 lg:py-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 text-center">
    <span class="inline-block px-5 py-2 bg-lynx-red/15 text-lynx-red text-xs font-bold tracking-widest uppercase rounded-full mb-3">{{ t('nav.advantages') }}</span>
    <h1 class="font-heading text-3xl lg:text-5xl font-extrabold text-white leading-tight">{{ t('advantages_page.title') }}</h1>
    <p class="text-base text-white/60 max-w-2xl mx-auto mt-3">{{ t('advantages_page.subtitle') }}</p>
  </div>
</section>

{# ===== VORTEILE GRID ===== #}
<section class="max-w-7xl mx-auto px-6 lg:px-10 -mt-16 relative z-10 pb-24">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% set staticAdvantages = [
      { icon: "🛡️", title: "Extrem verschleißfest", desc: "Bis zu 30x längere Lebensdauer als herkömmliche Verschleißschutzmaterialien. Bewährt unter härtesten Bedingungen in Bergbau und Industrie." },
      { icon: "🔇", title: "Schalldämpfend", desc: "Reduzierung der Lärmbelastung um bis zu 21 dB. Verbessert die Arbeitsumgebung und erfüllt Lärmschutzvorgaben." },
      { icon: "🌸", title: "Anti-Haft (Lotuseffekt)", desc: "Materialanbackungen werden zuverlässig verhindert. Kein kostspieliger Stillstand durch Verstopfungen mehr." },
      { icon: "📈", title: "Vibrationsreduktion", desc: "Spürbare Dämpfung von Vibrationen verlängert die Lebensdauer der gesamten Anlage und reduziert Wartungskosten." },
      { icon: "♻️", title: "100% recyclebar", desc: "Nachhaltiger Verschleißschutz – vollständig wiederverwertbar. Produziert in Österreich mit höchsten Umweltstandards." },
      { icon: "🌦️", title: "Wetterbeständig", desc: "Beständig gegen Witterung, Hitze, UV-Strahlung und extreme Bedingungen. Einsetzbar bei -40°C bis +80°C." }
    ] %}
    {% set advList = advantages if advantages.length else staticAdvantages %}

    {% for adv in advList %}
      <div class="bg-white rounded-2xl p-10 shadow-lg border border-black/4 hover:-translate-y-2 transition-all duration-300">
        <div class="w-16 h-16 bg-lynx-red/8 rounded-2xl flex items-center justify-center mx-auto mb-6 text-3xl">
          {% if adv.icon_path %}
            <img src="{{ adv.icon_path }}" alt="{{ adv.title }}" class="w-10 h-10">
          {% else %}
            {{ adv.icon }}
          {% endif %}
        </div>
        <h3 class="font-heading text-xl font-bold text-stone-dark mb-4 text-center">{{ adv.title }}</h3>
        <p class="text-stone leading-relaxed text-center">{{ adv.desc or adv.description }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{# ===== WEITERE VORTEILE LISTE ===== #}
<section class="bg-white py-24">
  <div class="max-w-4xl mx-auto px-6 lg:px-10">
    <div class="text-center mb-16">
      <h2 class="font-heading text-3xl lg:text-4xl font-extrabold text-stone-dark">{{ t('advantages_page.benefits_title') }}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {% for benefit in t('advantages_page.benefits') %}
        <div class="flex items-start gap-4 p-5 bg-[#FAFAF9] rounded-xl border border-black/4">
          <div class="flex-shrink-0 w-8 h-8 bg-lynx-red/10 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-lynx-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-stone-dark font-medium">{{ benefit }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== KONTAKT CTA ===== #}
<div class="max-w-7xl mx-auto px-6 lg:px-10 pb-24">
  <div class="bg-gradient-to-br from-lynx-red to-lynx-red-dark rounded-[2rem] p-12 lg:p-20 text-center">
    <h2 class="font-heading text-3xl lg:text-5xl font-extrabold text-white mb-4">{{ t('contact_cta.title') }}</h2>
    <p class="text-white/85 text-lg mb-10">{{ t('contact_cta.text') }}</p>
    <a href="/{{ locale }}/kontakt" class="btn-lift inline-flex items-center gap-2.5 px-10 py-4 bg-white text-lynx-red rounded-xl font-bold text-base shadow-[0_8px_30px_rgba(0,0,0,0.15)]">
      {{ t('contact_cta.button') }} &rarr;
    </a>
  </div>
</div>

{% endblock %}
