<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ metaDescription or t('site.description') }}">
  <link rel="alternate" hreflang="de" href="{{ localePath('de') }}">
  <link rel="alternate" hreflang="en" href="{{ localePath('en') }}">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#D64545">
  <link rel="stylesheet" href="/css/output.css">
  {% block head %}{% endblock %}
</head>
<body class="font-body text-stone antialiased bg-[#FAFAF9]">

  {% include "partials/header.njk" %}

  <main>
    {% block content %}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}

  {% include "partials/cookie-banner.njk" %}

  {% block scripts %}{% endblock %}
  <script src="/js/main.js" defer></script>
</body>
</html>
