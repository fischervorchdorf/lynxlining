{% extends "layouts/admin.njk" %}

{% block admin_content %}

<div class="bg-white rounded-xl border border-black/5 shadow-sm">
  <div class="px-6 py-4 border-b border-black/5">
    <h2 class="font-bold text-[#1E1E1E]">Alle Preisanfragen</h2>
  </div>

  {% if inquiries.length %}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-black/5 bg-[#FAFAF9]">
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Status</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Produkt</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Name</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">E-Mail</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Menge</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Datum</th>
            <th class="w-20"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5">
          {% for inq in inquiries %}
            <tr class="hover:bg-[#FAFAF9] transition-colors {% if not inq.is_read %}bg-amber-50/30{% endif %}">
              <td class="px-6 py-4">
                {% if inq.is_read %}
                  <span class="inline-block w-2 h-2 bg-stone/30 rounded-full"></span>
                {% else %}
                  <span class="inline-block w-2 h-2 bg-amber-500 rounded-full"></span>
                {% endif %}
              </td>
              <td class="px-6 py-4 font-medium text-[#1E1E1E] {% if not inq.is_read %}font-bold{% endif %}">{{ inq.product_name }}</td>
              <td class="px-6 py-4 text-stone">{{ inq.customer_name }}{% if inq.customer_company %} <span class="text-xs text-stone/50">({{ inq.customer_company }})</span>{% endif %}</td>
              <td class="px-6 py-4 text-stone"><a href="mailto:{{ inq.customer_email }}" class="text-[#D64545] hover:underline">{{ inq.customer_email }}</a></td>
              <td class="px-6 py-4 text-stone text-xs">
                {% if inq.quantity_lfm %}{{ inq.quantity_lfm }} lfm{% endif %}
                {% if inq.quantity_lfm and inq.quantity_sqm %} / {% endif %}
                {% if inq.quantity_sqm %}{{ inq.quantity_sqm }} m²{% endif %}
                {% if not inq.quantity_lfm and not inq.quantity_sqm %}–{% endif %}
              </td>
              <td class="px-6 py-4 text-stone text-xs">{{ inq.created_at }}</td>
              <td class="px-6 py-4">
                {% if not inq.is_read %}
                  <form method="POST" action="/admin/anfragen/{{ inq.id }}/read" class="inline">
                    <button class="text-xs text-[#D64545] font-medium hover:underline">Gelesen</button>
                  </form>
                {% endif %}
              </td>
            </tr>
            {% if inq.message or inq.customer_phone %}
              <tr class="{% if not inq.is_read %}bg-amber-50/30{% endif %}">
                <td></td>
                <td colspan="6" class="px-6 pb-4 text-stone text-sm">
                  {% if inq.customer_phone %}<span class="text-xs text-stone/60 mr-3">Tel: {{ inq.customer_phone }}</span>{% endif %}
                  {% if inq.message %}<p class="mt-1">{{ inq.message }}</p>{% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="px-6 py-16 text-center text-stone">
      <p class="text-lg">Keine Preisanfragen vorhanden</p>
    </div>
  {% endif %}
</div>

{% endblock %}
