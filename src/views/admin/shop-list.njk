{% extends "layouts/admin.njk" %}

{% block admin_content %}

<div class="flex justify-between items-center mb-8">
  <div>
    <p class="text-stone text-sm">{{ products.length }} Produkte im Shop</p>
  </div>
  <a href="/admin/shop-produkte/neu" class="px-5 py-2.5 bg-[#D64545] text-white rounded-xl font-semibold text-sm shadow-md hover:bg-[#C13B3B] transition-colors">
    + Neues Produkt
  </a>
</div>

{% if products.length == 0 %}
  <div class="bg-white rounded-2xl shadow-sm border border-black/5 p-12 text-center">
    <p class="text-stone text-lg">Noch keine Shop-Produkte vorhanden.</p>
    <a href="/admin/shop-produkte/neu" class="inline-block mt-4 px-6 py-2.5 bg-[#D64545] text-white rounded-xl font-semibold text-sm">Erstes Produkt anlegen</a>
  </div>
{% else %}

<div class="bg-white rounded-2xl shadow-sm border border-black/5 overflow-hidden">
  <table class="w-full">
    <thead class="bg-[#FAFAF9] border-b border-black/5">
      <tr>
        <th class="text-left px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">Bild</th>
        <th class="text-left px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">Produkt</th>
        <th class="text-left px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">SKU</th>
        <th class="text-left px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">Staffelpreise</th>
        <th class="text-center px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">Status</th>
        <th class="text-center px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">Reihenfolge</th>
        <th class="text-right px-6 py-3 text-xs font-semibold text-stone uppercase tracking-wider">Aktionen</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-black/5">
      {% for prod in products %}
      <tr class="hover:bg-[#FAFAF9] transition-colors {% if not prod.is_active %}opacity-50{% endif %}">
        <td class="px-6 py-4">
          <img src="{{ prod.image_path }}" alt="{{ prod.name_de }}" class="w-16 h-12 object-cover rounded-lg border border-black/5">
        </td>
        <td class="px-6 py-4">
          <div class="font-semibold text-[#1E1E1E] text-sm">{{ prod.name_de }}</div>
          <div class="text-xs text-stone mt-0.5">{{ prod.unit }}</div>
        </td>
        <td class="px-6 py-4 text-sm text-stone font-mono">{{ prod.sku }}</td>
        <td class="px-6 py-4">
          {% if prod.tiers.length %}
            <div class="space-y-0.5">
              {% for tier in prod.tiers %}
                <div class="text-xs text-stone">
                  ab {{ tier.min_quantity | int }} {{ prod.unit }}: <span class="font-semibold text-[#1E1E1E]">€{{ tier.price_per_unit }}</span>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <span class="text-xs text-stone/50">Keine Preise</span>
          {% endif %}
        </td>
        <td class="px-6 py-4 text-center">
          <form method="POST" action="/admin/shop-produkte/{{ prod.id }}/toggle" class="inline">
            <button type="submit" class="px-3 py-1 rounded-full text-xs font-semibold transition-colors
              {% if prod.is_active %}bg-green-100 text-green-700 hover:bg-green-200{% else %}bg-red-100 text-red-700 hover:bg-red-200{% endif %}">
              {% if prod.is_active %}Aktiv{% else %}Inaktiv{% endif %}
            </button>
          </form>
        </td>
        <td class="px-6 py-4 text-center text-sm text-stone">{{ prod.sort_order }}</td>
        <td class="px-6 py-4 text-right">
          <div class="flex items-center justify-end gap-2">
            <a href="/admin/shop-produkte/{{ prod.id }}" class="px-3 py-1.5 bg-[#FAFAF9] border border-black/8 rounded-lg text-xs font-medium text-stone hover:border-[#D64545] hover:text-[#D64545] transition-colors">
              Bearbeiten
            </a>
            <form method="POST" action="/admin/shop-produkte/{{ prod.id }}/delete" onsubmit="return confirm('Produkt wirklich löschen?')">
              <button type="submit" class="px-3 py-1.5 bg-red-50 border border-red-200 rounded-lg text-xs font-medium text-red-600 hover:bg-red-100 transition-colors">
                Löschen
              </button>
            </form>
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endif %}

{% endblock %}
