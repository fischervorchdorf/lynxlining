{% extends "layouts/admin.njk" %}

{% block admin_content %}

{# Stats Cards #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl p-6 border border-black/5 shadow-sm">
    <div class="flex justify-between items-start">
      <div>
        <p class="text-sm text-stone font-medium">Neue Anfragen</p>
        <p class="text-3xl font-bold text-[#1E1E1E] mt-1">{{ stats.unreadContacts }}</p>
      </div>
      <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <a href="/admin/kontakt" class="text-xs text-blue-500 font-medium mt-3 inline-block hover:underline">Alle ansehen &rarr;</a>
  </div>

  <div class="bg-white rounded-xl p-6 border border-black/5 shadow-sm">
    <div class="flex justify-between items-start">
      <div>
        <p class="text-sm text-stone font-medium">Neue Bestellungen</p>
        <p class="text-3xl font-bold text-[#1E1E1E] mt-1">{{ stats.unreadOrders }}</p>
      </div>
      <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
    </div>
    <a href="/admin/bestellungen" class="text-xs text-green-500 font-medium mt-3 inline-block hover:underline">Alle ansehen &rarr;</a>
  </div>

  <div class="bg-white rounded-xl p-6 border border-black/5 shadow-sm">
    <div class="flex justify-between items-start">
      <div>
        <p class="text-sm text-stone font-medium">Bestellungen gesamt</p>
        <p class="text-3xl font-bold text-[#1E1E1E] mt-1">{{ stats.totalOrders }}</p>
      </div>
      <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl p-6 border border-black/5 shadow-sm">
    <div class="flex justify-between items-start">
      <div>
        <p class="text-sm text-stone font-medium">Aktive Produkte</p>
        <p class="text-3xl font-bold text-[#1E1E1E] mt-1">{{ stats.activeProducts }}</p>
      </div>
      <div class="w-10 h-10 bg-orange-50 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      </div>
    </div>
  </div>
</div>

{# Recent Activity #}
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  {# Letzte Bestellungen #}
  <div class="bg-white rounded-xl border border-black/5 shadow-sm">
    <div class="px-6 py-4 border-b border-black/5 flex justify-between items-center">
      <h2 class="font-bold text-[#1E1E1E]">Letzte Bestellungen</h2>
      <a href="/admin/bestellungen" class="text-xs text-[#D64545] font-medium hover:underline">Alle &rarr;</a>
    </div>
    <div class="divide-y divide-black/5">
      {% if recentOrders.length %}
        {% for order in recentOrders %}
          <div class="px-6 py-3 flex justify-between items-center">
            <div>
              <span class="text-sm font-medium text-[#1E1E1E]">{{ order.order_number }}</span>
              <span class="text-xs text-stone ml-2">{{ order.customer_name }}</span>
            </div>
            <div class="text-right">
              <span class="text-sm font-bold text-[#D64545]">€ {{ order.total_amount }}</span>
              <span class="block text-xs text-stone {% if order.status == 'neu' %}text-green-500{% endif %}">{{ order.status }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="px-6 py-8 text-center text-stone text-sm">Noch keine Bestellungen</div>
      {% endif %}
    </div>
  </div>

  {# Letzte Kontaktanfragen #}
  <div class="bg-white rounded-xl border border-black/5 shadow-sm">
    <div class="px-6 py-4 border-b border-black/5 flex justify-between items-center">
      <h2 class="font-bold text-[#1E1E1E]">Letzte Kontaktanfragen</h2>
      <a href="/admin/kontakt" class="text-xs text-[#D64545] font-medium hover:underline">Alle &rarr;</a>
    </div>
    <div class="divide-y divide-black/5">
      {% if recentContacts.length %}
        {% for contact in recentContacts %}
          <div class="px-6 py-3 flex justify-between items-center">
            <div>
              <span class="text-sm font-medium text-[#1E1E1E] {% if not contact.is_read %}font-bold{% endif %}">{{ contact.name }}</span>
              <span class="text-xs text-stone ml-2">{{ contact.subject or contact.email }}</span>
            </div>
            <div>
              {% if not contact.is_read %}
                <span class="inline-block w-2 h-2 bg-[#D64545] rounded-full"></span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="px-6 py-8 text-center text-stone text-sm">Noch keine Anfragen</div>
      {% endif %}
    </div>
  </div>
</div>

{% endblock %}
