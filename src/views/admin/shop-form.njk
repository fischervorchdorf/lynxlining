{% extends "layouts/admin.njk" %}

{% block admin_content %}

<div class="mb-6">
  <a href="/admin/shop-produkte" class="inline-flex items-center gap-2 text-sm text-stone hover:text-[#D64545] transition-colors">
    &larr; Zurück zur Übersicht
  </a>
</div>

<form method="POST" action="/admin/shop-produkte{% if not isNew %}/{{ product.id }}{% endif %}" enctype="multipart/form-data" class="space-y-8">

  {# Grunddaten #}
  <div class="bg-white rounded-2xl shadow-sm border border-black/5 p-6 lg:p-8">
    <h2 class="font-bold text-lg text-[#1E1E1E] mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-[#D64545]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
      Grunddaten
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Slug <span class="text-[#D64545]">*</span></label>
        <input type="text" name="slug" value="{{ product.slug if product else '' }}" required
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="ll-standard-5mm">
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">SKU (Artikelnummer)</label>
        <input type="text" name="sku" value="{{ product.sku if product else '' }}"
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="LL-STD-5MM">
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Einheit</label>
        <select name="unit" class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
          <option value="lfm" {% if not product or product.unit == 'lfm' %}selected{% endif %}>lfm (Laufmeter)</option>
          <option value="m²" {% if product and product.unit == 'm²' %}selected{% endif %}>m² (Quadratmeter)</option>
          <option value="stk" {% if product and product.unit == 'stk' %}selected{% endif %}>Stück</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Reihenfolge</label>
        <input type="number" name="sort_order" value="{{ product.sort_order if product else 0 }}"
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Mindestbestellmenge</label>
        <input type="number" name="min_quantity" step="0.5" value="{{ product.min_quantity if product else 1 }}"
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Status</label>
        <label class="flex items-center gap-3 mt-2 cursor-pointer">
          <input type="checkbox" name="is_active" value="1" {% if isNew or (product and product.is_active) %}checked{% endif %}
                 class="w-4 h-4 accent-[#D64545] rounded">
          <span class="text-sm text-[#3D3D3D]">Aktiv (im Shop sichtbar)</span>
        </label>
      </div>
    </div>

    {# Produktbild #}
    <div class="mt-5">
      <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Produktbild</label>
      {% if product and product.image_path %}
        <div class="flex items-center gap-4 mb-3">
          <img src="{{ product.image_path }}" alt="Aktuelles Bild" class="w-24 h-20 object-cover rounded-lg border border-black/5">
          <span class="text-xs text-stone">{{ product.image_path }}</span>
          <input type="hidden" name="existing_image" value="{{ product.image_path }}">
        </div>
      {% endif %}
      <input type="file" name="image" accept="image/*"
             class="w-full text-sm text-stone file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-[#D64545]/10 file:text-[#D64545] hover:file:bg-[#D64545]/20">
      <p class="text-xs text-stone/60 mt-1">{% if product %}Neues Bild hochladen um das aktuelle zu ersetzen{% else %}JPG, PNG oder WebP{% endif %}</p>
    </div>
  </div>

  {# Übersetzungen DE #}
  <div class="bg-white rounded-2xl shadow-sm border border-black/5 p-6 lg:p-8">
    <h2 class="font-bold text-lg text-[#1E1E1E] mb-6 flex items-center gap-2">
      <span class="w-7 h-5 bg-black rounded overflow-hidden flex flex-col">
        <span class="h-1/3 bg-black"></span>
        <span class="h-1/3 bg-[#D64545]"></span>
        <span class="h-1/3 bg-[#FFD700]"></span>
      </span>
      Deutsch
    </h2>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Produktname <span class="text-[#D64545]">*</span></label>
        <input type="text" name="name_de" value="{{ product.de.name if product and product.de else '' }}" required
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="LYNX Lining Standard 5mm">
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Kurzbeschreibung</label>
        <input type="text" name="short_desc_de" value="{{ product.de.short_description if product and product.de else '' }}"
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="Verschleißschutzfolie aus TPU – Der Allrounder in 5mm Stärke">
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Beschreibung</label>
        <textarea name="desc_de" rows="3"
                  class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none resize-none"
                  placeholder="Ausführliche Produktbeschreibung...">{{ product.de.description if product and product.de else '' }}</textarea>
      </div>
    </div>
  </div>

  {# Übersetzungen EN #}
  <div class="bg-white rounded-2xl shadow-sm border border-black/5 p-6 lg:p-8">
    <h2 class="font-bold text-lg text-[#1E1E1E] mb-6 flex items-center gap-2">
      <span class="w-7 h-5 rounded overflow-hidden flex items-center justify-center bg-blue-800 text-white text-[8px] font-bold">EN</span>
      English
    </h2>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Product Name</label>
        <input type="text" name="name_en" value="{{ product.en.name if product and product.en else '' }}"
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="LYNX Lining Standard 5mm">
        <p class="text-xs text-stone/60 mt-1">Falls leer, wird der deutsche Name verwendet</p>
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Short Description</label>
        <input type="text" name="short_desc_en" value="{{ product.en.short_description if product and product.en else '' }}"
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="TPU wear protection film – The all-rounder in 5mm thickness">
      </div>
      <div>
        <label class="block text-sm font-semibold text-[#3D3D3D] mb-2">Description</label>
        <textarea name="desc_en" rows="3"
                  class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none resize-none"
                  placeholder="Detailed product description...">{{ product.en.description if product and product.en else '' }}</textarea>
      </div>
    </div>
  </div>

  {# Staffelpreise #}
  <div class="bg-white rounded-2xl shadow-sm border border-black/5 p-6 lg:p-8">
    <h2 class="font-bold text-lg text-[#1E1E1E] mb-2 flex items-center gap-2">
      <svg class="w-5 h-5 text-[#D64545]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Staffelpreise
    </h2>
    <p class="text-sm text-stone mb-6">Je mehr bestellt wird, desto günstiger der Stückpreis. Mindestens einen Preis angeben.</p>

    <div id="tier-container" class="space-y-3">
      {% if tiers.length %}
        {% for tier in tiers %}
          <div class="tier-row flex items-center gap-4">
            <div class="flex-1">
              <label class="block text-xs font-semibold text-stone mb-1">Ab Menge</label>
              <input type="number" name="tier_min" step="0.5" value="{{ tier.min_quantity }}" required
                     class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
            </div>
            <div class="flex-1">
              <label class="block text-xs font-semibold text-stone mb-1">Preis pro Einheit (€)</label>
              <input type="number" name="tier_price" step="0.01" value="{{ tier.price_per_unit }}" required
                     class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
            </div>
            <button type="button" onclick="this.closest('.tier-row').remove()" class="mt-5 p-2 text-stone/40 hover:text-red-500 transition-colors" title="Entfernen">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        {% endfor %}
      {% else %}
        <div class="tier-row flex items-center gap-4">
          <div class="flex-1">
            <label class="block text-xs font-semibold text-stone mb-1">Ab Menge</label>
            <input type="number" name="tier_min" step="0.5" value="1" required
                   class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
          </div>
          <div class="flex-1">
            <label class="block text-xs font-semibold text-stone mb-1">Preis pro Einheit (€)</label>
            <input type="number" name="tier_price" step="0.01" value="" required
                   class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
                   placeholder="29.90">
          </div>
          <button type="button" onclick="this.closest('.tier-row').remove()" class="mt-5 p-2 text-stone/40 hover:text-red-500 transition-colors" title="Entfernen">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      {% endif %}
    </div>

    <button type="button" onclick="addTierRow()" class="mt-4 px-4 py-2 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm font-medium text-stone hover:border-[#D64545] hover:text-[#D64545] transition-colors">
      + Staffelpreis hinzufügen
    </button>
  </div>

  {# Submit #}
  <div class="flex items-center gap-4">
    <button type="submit" class="px-8 py-3 bg-[#D64545] text-white rounded-xl font-bold text-sm shadow-md hover:bg-[#C13B3B] transition-colors">
      {% if isNew %}Produkt anlegen{% else %}Änderungen speichern{% endif %}
    </button>
    <a href="/admin/shop-produkte" class="px-6 py-3 text-sm font-medium text-stone hover:text-[#1E1E1E] transition-colors">Abbrechen</a>
  </div>
</form>

<script>
function addTierRow() {
  const container = document.getElementById('tier-container');
  const html = `
    <div class="tier-row flex items-center gap-4">
      <div class="flex-1">
        <label class="block text-xs font-semibold text-stone mb-1">Ab Menge</label>
        <input type="number" name="tier_min" step="0.5" value="" required
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="10">
      </div>
      <div class="flex-1">
        <label class="block text-xs font-semibold text-stone mb-1">Preis pro Einheit (€)</label>
        <input type="number" name="tier_price" step="0.01" value="" required
               class="w-full px-4 py-2.5 bg-[#FAFAF9] border border-black/8 rounded-xl text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none"
               placeholder="24.90">
      </div>
      <button type="button" onclick="this.closest('.tier-row').remove()" class="mt-5 p-2 text-stone/40 hover:text-red-500 transition-colors" title="Entfernen">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </button>
    </div>`;
  container.insertAdjacentHTML('beforeend', html);
}
</script>

{% endblock %}
