{% extends "layouts/admin.njk" %}

{% block admin_content %}

<a href="/admin/news" class="inline-flex items-center gap-1 text-sm text-stone hover:text-[#D64545] mb-6 transition-colors">&larr; Zurück</a>

<div class="max-w-3xl">
  <form method="POST" action="/admin/news{% if not isNew %}/{{ item.id }}{% endif %}" enctype="multipart/form-data" class="space-y-8">

    <div class="bg-white rounded-xl border border-black/5 shadow-sm p-6">
      <h2 class="font-bold text-[#1E1E1E] mb-4">Allgemein</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Beitragsbild</label>
          {% if item and item.image_path %}
            <img src="{{ item.image_path }}" class="w-40 h-24 rounded-lg object-cover mb-2" alt="">
            <input type="hidden" name="existing_image" value="{{ item.image_path }}">
          {% endif %}
          <input type="file" name="image" accept="image/*" class="text-sm text-stone file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-[#D64545]/10 file:text-[#D64545] hover:file:bg-[#D64545]/20">
        </div>
        <div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="is_active" value="1" {% if not item or item.is_active %}checked{% endif %}
                   class="w-4 h-4 rounded border-black/20 text-[#D64545] focus:ring-[#D64545]">
            <span class="text-sm font-medium text-[#1E1E1E]">Veröffentlicht</span>
          </label>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-black/5 shadow-sm p-6">
      <h2 class="font-bold text-[#1E1E1E] mb-4">Deutsch</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Titel</label>
          <input type="text" name="title_de" value="{{ item.de.title if item and item.de else '' }}" required
                 class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Kurzbeschreibung</label>
          <textarea name="excerpt_de" rows="2" class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none resize-none">{{ item.de.excerpt if item and item.de else '' }}</textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Inhalt</label>
          <textarea name="content_de" rows="8" class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none resize-none">{{ item.de.content if item and item.de else '' }}</textarea>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-black/5 shadow-sm p-6">
      <h2 class="font-bold text-[#1E1E1E] mb-4">English</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Title</label>
          <input type="text" name="title_en" value="{{ item.en.title if item and item.en else '' }}"
                 class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Excerpt</label>
          <textarea name="excerpt_en" rows="2" class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none resize-none">{{ item.en.excerpt if item and item.en else '' }}</textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Content</label>
          <textarea name="content_en" rows="8" class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none resize-none">{{ item.en.content if item and item.en else '' }}</textarea>
        </div>
      </div>
    </div>

    <button type="submit" class="px-8 py-3 bg-[#D64545] text-white rounded-lg font-bold shadow-md hover:bg-[#C13B3B] transition-colors">
      {% if isNew %}Veröffentlichen{% else %}Speichern{% endif %}
    </button>
  </form>
</div>

{% endblock %}
