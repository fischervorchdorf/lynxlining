{% extends "layouts/admin.njk" %}

{% block admin_content %}

<div class="flex justify-between items-center mb-6">
  <div></div>
  <a href="/admin/{{ contentType }}/neu" class="px-5 py-2.5 bg-[#D64545] text-white rounded-lg font-semibold text-sm hover:bg-[#C13B3B] transition-colors">
    + Neu anlegen
  </a>
</div>

<div class="bg-white rounded-xl border border-black/5 shadow-sm">
  {% if items.length %}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-black/5 bg-[#FAFAF9]">
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider w-16">Bild</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Titel (DE)</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Titel (EN)</th>
            <th class="text-center px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider w-20">Reihenfolge</th>
            <th class="text-center px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider w-20">Aktiv</th>
            <th class="w-32"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5">
          {% for item in items %}
            <tr class="hover:bg-[#FAFAF9] transition-colors">
              <td class="px-6 py-3">
                {% if item.image_path or item.icon_path %}
                  <img src="{{ item.image_path or item.icon_path }}" class="w-12 h-12 rounded-lg object-cover" alt="">
                {% else %}
                  <div class="w-12 h-12 bg-stone-light rounded-lg"></div>
                {% endif %}
              </td>
              <td class="px-6 py-3 font-medium text-[#1E1E1E]">{{ item.title_de or '–' }}</td>
              <td class="px-6 py-3 text-stone">{{ item.title_en or '–' }}</td>
              <td class="px-6 py-3 text-center text-stone">{{ item.sort_order }}</td>
              <td class="px-6 py-3 text-center">
                {% if item.is_active or item.is_active === undefined %}
                  <span class="inline-block w-2 h-2 bg-green-500 rounded-full"></span>
                {% else %}
                  <span class="inline-block w-2 h-2 bg-stone/30 rounded-full"></span>
                {% endif %}
              </td>
              <td class="px-6 py-3 text-right space-x-2">
                <a href="/admin/{{ contentType }}/{{ item.id }}" class="text-xs text-[#D64545] font-medium hover:underline">Bearbeiten</a>
                <form method="POST" action="/admin/{{ contentType }}/{{ item.id }}/delete" class="inline" onsubmit="return confirm('Wirklich löschen?')">
                  <button class="text-xs text-stone/40 hover:text-red-500 font-medium">Löschen</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="px-6 py-16 text-center text-stone">
      <p class="text-lg mb-4">Noch keine Einträge vorhanden</p>
      <a href="/admin/{{ contentType }}/neu" class="text-[#D64545] font-medium hover:underline">Ersten Eintrag anlegen &rarr;</a>
    </div>
  {% endif %}
</div>

{% endblock %}
