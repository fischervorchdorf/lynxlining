{% extends "layouts/admin.njk" %}

{% block admin_content %}

<div class="bg-white rounded-xl border border-black/5 shadow-sm">
  <div class="px-6 py-4 border-b border-black/5">
    <h2 class="font-bold text-[#1E1E1E]">Alle Bestellungen</h2>
  </div>

  {% if orders.length %}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-black/5 bg-[#FAFAF9]">
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Nr.</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Kunde</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Firma</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Betrag</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Status</th>
            <th class="text-left px-6 py-3 font-semibold text-stone text-xs uppercase tracking-wider">Datum</th>
            <th class="w-20"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5">
          {% for order in orders %}
            <tr class="hover:bg-[#FAFAF9] transition-colors {% if not order.is_read %}bg-green-50/30{% endif %}">
              <td class="px-6 py-4 font-mono text-xs font-bold text-[#1E1E1E]">{{ order.order_number }}</td>
              <td class="px-6 py-4 text-[#1E1E1E] {% if not order.is_read %}font-bold{% endif %}">{{ order.customer_name }}</td>
              <td class="px-6 py-4 text-stone">{{ order.customer_company or '–' }}</td>
              <td class="px-6 py-4 font-bold text-[#D64545]">€ {{ order.total_amount }}</td>
              <td class="px-6 py-4">
                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold
                  {% if order.status == 'neu' %}bg-green-100 text-green-700
                  {% elif order.status == 'bearbeitung' %}bg-yellow-100 text-yellow-700
                  {% elif order.status == 'versendet' %}bg-blue-100 text-blue-700
                  {% elif order.status == 'abgeschlossen' %}bg-stone-100 text-stone
                  {% elif order.status == 'storniert' %}bg-red-100 text-red-700
                  {% else %}bg-stone-100 text-stone{% endif %}">
                  {{ order.status }}
                </span>
              </td>
              <td class="px-6 py-4 text-stone text-xs">{{ order.created_at }}</td>
              <td class="px-6 py-4">
                <a href="/admin/bestellungen/{{ order.id }}" class="text-xs text-[#D64545] font-medium hover:underline">Details &rarr;</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="px-6 py-16 text-center text-stone">
      <p class="text-lg">Keine Bestellungen vorhanden</p>
    </div>
  {% endif %}
</div>

{% endblock %}
