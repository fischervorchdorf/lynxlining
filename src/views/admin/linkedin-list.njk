{% extends "layouts/admin.njk" %}

{% block admin_content %}

{% if flash %}
  <div class="mb-6 px-5 py-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-800">{{ flash }}</div>
{% endif %}

<!-- Auto-Import -->
<div class="bg-white rounded-xl border border-black/5 shadow-sm p-6 mb-6">
  <div class="flex items-start justify-between gap-6 flex-wrap">
    <div>
      <h2 class="font-semibold text-stone-dark flex items-center gap-2">
        <svg class="w-5 h-5 text-[#0A66C2]" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        Automatischer Import
      </h2>

      <div class="mt-3 space-y-1.5 text-sm">
        <!-- Offizielle LinkedIn-API -->
        <p class="flex items-center gap-2 flex-wrap">
          {% if autoStatus.api.connected %}
            <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-medium">LinkedIn verbunden</span>
            <span class="text-stone/60">
              {% if autoStatus.api.organizationName %}Seite: {{ autoStatus.api.organizationName }}{% else %}keine Seite zugeordnet{% endif %}
              {% if autoStatus.api.daysLeft !== null %}
                &middot;
                <span class="{% if autoStatus.api.daysLeft <= 7 %}text-amber-600 font-medium{% endif %}">
                  Zugang noch {{ autoStatus.api.daysLeft }} Tage gültig
                </span>
              {% endif %}
            </span>
          {% elif autoStatus.api.configured %}
            <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-medium">Nicht verbunden</span>
            <span class="text-stone/60">App ist hinterlegt – Verbindung muss noch hergestellt werden</span>
          {% else %}
            <span class="px-2 py-0.5 rounded-full bg-stone/10 text-stone/50 text-xs font-medium">API nicht eingerichtet</span>
            <span class="text-stone/60">LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET fehlen</span>
          {% endif %}
        </p>
        <p class="flex items-center gap-2">
          {% if autoStatus.hasFeed %}
            <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-medium">Feed aktiv</span>
            <span class="text-stone/60">alle {{ autoStatus.intervalMin }} Minuten</span>
          {% else %}
            <span class="px-2 py-0.5 rounded-full bg-stone/10 text-stone/50 text-xs font-medium">Feed inaktiv</span>
            <span class="text-stone/60">LINKEDIN_FEED_URL nicht gesetzt</span>
          {% endif %}
        </p>
        <p class="flex items-center gap-2">
          {% if autoStatus.hasWebhook %}
            <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-medium">Webhook aktiv</span>
            <span class="text-stone/60">POST /api/linkedin/webhook</span>
          {% else %}
            <span class="px-2 py-0.5 rounded-full bg-stone/10 text-stone/50 text-xs font-medium">Webhook inaktiv</span>
            <span class="text-stone/60">LINKEDIN_WEBHOOK_TOKEN nicht gesetzt</span>
          {% endif %}
        </p>
        <p class="flex items-center gap-2">
          {% if autoStatus.canTranslate %}
            <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-medium">Übersetzung aktiv</span>
            <span class="text-stone/60">
              {% if autoStatus.translateProvider == 'claude' %}
                Claude – kennt die Fachbegriffe, wenige Cent pro Beitrag
              {% else %}
                Google Translate – kostenlos, wörtlicher. Für Fachtexte besser: ANTHROPIC_API_KEY setzen
              {% endif %}
              {% if autoStatus.untranslatedCount %} &middot; {{ autoStatus.untranslatedCount }} noch ohne Übersetzung{% endif %}
            </span>
          {% else %}
            <span class="px-2 py-0.5 rounded-full bg-stone/10 text-stone/50 text-xs font-medium">Übersetzung abgeschaltet</span>
            <span class="text-stone/60">LINKEDIN_AUTO_TRANSLATE=false – englische Seite zeigt den deutschen Text</span>
          {% endif %}
        </p>
        <p class="text-stone/60">
          {{ autoStatus.importedCount }} automatisch importierte Beiträge
          {% if autoStatus.lastImport %} &middot; zuletzt {{ autoStatus.lastImport | formatDate('de') }}{% endif %}
          &middot; neue Beiträge werden
          {% if autoStatus.autoPublish %}sofort veröffentlicht{% else %}versteckt angelegt und warten auf Freigabe{% endif %}
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-2 items-stretch">
      <form method="POST" action="/admin/linkedin/sync">
        <button class="w-full px-5 py-2.5 bg-[#0A66C2] text-white rounded-lg font-semibold text-sm hover:bg-[#08519B] transition-colors whitespace-nowrap">
          Jetzt abrufen
        </button>
      </form>

      {% if autoStatus.api.configured %}
        {% if autoStatus.api.connected %}
          <form method="POST" action="/admin/linkedin/disconnect" onsubmit="return confirm('LinkedIn-Verbindung wirklich trennen?')">
            <button class="w-full px-5 py-2.5 bg-stone/10 text-stone rounded-lg font-medium text-sm hover:bg-stone/20 transition-colors whitespace-nowrap">
              Verbindung trennen
            </button>
          </form>
        {% else %}
          <a href="/admin/linkedin/connect" class="block text-center px-5 py-2.5 bg-[#0A66C2]/10 text-[#0A66C2] rounded-lg font-semibold text-sm hover:bg-[#0A66C2]/20 transition-colors whitespace-nowrap">
            Mit LinkedIn verbinden
          </a>
        {% endif %}
      {% endif %}
    </div>
  </div>

  {% if autoStatus.api.connected and autoStatus.api.daysLeft <= 7 and not autoStatus.api.hasRefreshToken %}
    <div class="mt-4 px-4 py-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800">
      Der LinkedIn-Zugang läuft in {{ autoStatus.api.daysLeft }} Tagen ab. LinkedIn begrenzt Zugänge auf
      60 Tage. Bitte einmal auf <strong>Verbindung trennen</strong> und dann
      <strong>Mit LinkedIn verbinden</strong> klicken – danach läuft der Import wieder 60 Tage.
    </div>
  {% endif %}

  <form method="POST" action="/admin/linkedin/import-url" class="mt-5 pt-5 border-t border-black/5 space-y-3">
    <div>
      <label class="block text-xs font-semibold text-stone-dark mb-1">Beitrag übernehmen</label>
      <input type="url" name="url" placeholder="https://www.linkedin.com/posts/... (Link zum Beitrag)"
             class="w-full px-4 py-2.5 border border-black/10 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0A66C2]/30">
    </div>
    <div>
      <textarea name="text" rows="4" placeholder="Beitragstext hier einfügen – dann werden Titel und Kurztext automatisch daraus gebildet und die englische Fassung gleich mitübersetzt."
                class="w-full px-4 py-2.5 border border-black/10 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0A66C2]/30"></textarea>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
      <button class="px-5 py-2.5 bg-stone/10 text-stone-dark rounded-lg font-semibold text-sm hover:bg-stone/20 transition-colors whitespace-nowrap">
        Übernehmen
      </button>
      <span class="text-xs text-stone/50">
        Am schnellsten: In LinkedIn den Beitragstext markieren, kopieren und hier einfügen – dazu den Link.
        Nur mit Link versucht die Website, Titel, Text und Bild selbst bei LinkedIn zu holen; das gelingt nicht immer.
      </span>
    </div>
  </form>
</div>

<div class="flex justify-between items-center mb-6">
  <p class="text-sm text-stone">LinkedIn-Beiträge verwalten und auf der News-Seite anzeigen.</p>
  <a href="/admin/linkedin/neu" class="px-5 py-2.5 bg-[#D64545] text-white rounded-lg font-semibold text-sm hover:bg-[#C13B3B] transition-colors">
    + Neuer Beitrag
  </a>
</div>

<div class="bg-white rounded-xl border border-black/5 shadow-sm">
  {% if posts.length %}
    <table class="w-full">
      <thead>
        <tr class="border-b border-black/5 text-left">
          <th class="px-6 py-3 text-xs font-semibold text-stone/60 uppercase tracking-wider">Bild</th>
          <th class="px-6 py-3 text-xs font-semibold text-stone/60 uppercase tracking-wider">Titel</th>
          <th class="px-6 py-3 text-xs font-semibold text-stone/60 uppercase tracking-wider">Autor</th>
          <th class="px-6 py-3 text-xs font-semibold text-stone/60 uppercase tracking-wider">Datum</th>
          <th class="px-6 py-3 text-xs font-semibold text-stone/60 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-xs font-semibold text-stone/60 uppercase tracking-wider">Aktionen</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-black/5">
        {% for post in posts %}
          <tr class="{% if not post.is_visible %}opacity-50{% endif %}">
            <td class="px-6 py-4">
              {% if post.image_path %}
                <img src="{{ post.image_path }}" alt="" class="w-16 h-16 object-cover rounded-lg">
              {% else %}
                <div class="w-16 h-16 bg-[#0A66C2]/10 rounded-lg flex items-center justify-center">
                  <svg class="w-8 h-8 text-[#0A66C2]" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                </div>
              {% endif %}
            </td>
            <td class="px-6 py-4">
              <a href="/admin/linkedin/{{ post.id }}" class="font-medium text-stone-dark hover:text-[#D64545] transition-colors">
                {{ post.title_de or '(Ohne Titel)' }}
              </a>
              {% if post.needs_translation %}
                <span class="ml-2 px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-medium align-middle">EN fehlt</span>
              {% endif %}
              {% if post.excerpt_de %}
                <p class="text-xs text-stone/60 mt-1 line-clamp-1" style="display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">{{ post.excerpt_de }}</p>
              {% endif %}
            </td>
            <td class="px-6 py-4 text-sm text-stone">
              {{ post.author_name }}
              {% if post.source and post.source != 'manual' %}
                <span class="block mt-1 text-xs text-[#0A66C2]">automatisch ({{ post.source }})</span>
              {% endif %}
            </td>
            <td class="px-6 py-4 text-sm text-stone/60">{{ post.published_at }}</td>
            <td class="px-6 py-4">
              <form method="POST" action="/admin/linkedin/{{ post.id }}/toggle">
                <button class="px-3 py-1 rounded-full text-xs font-medium transition-colors
                  {% if post.is_visible %}bg-green-100 text-green-700 hover:bg-red-50 hover:text-red-500{% else %}bg-stone/10 text-stone/50 hover:bg-green-50 hover:text-green-600{% endif %}">
                  {% if post.is_visible %}Sichtbar{% else %}Versteckt{% endif %}
                </button>
              </form>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <a href="/admin/linkedin/{{ post.id }}" class="px-3 py-1.5 bg-stone/5 rounded-lg text-xs font-medium text-stone hover:bg-stone/10 transition-colors">Bearbeiten</a>
                {% if autoStatus.canTranslate %}
                  <form method="POST" action="/admin/linkedin/{{ post.id }}/translate">
                    <button class="px-3 py-1.5 bg-[#0A66C2]/10 rounded-lg text-xs font-medium text-[#0A66C2] hover:bg-[#0A66C2]/20 transition-colors">
                      {% if post.needs_translation %}Englisch übersetzen{% else %}EN neu übersetzen{% endif %}
                    </button>
                  </form>
                {% endif %}
                <form method="POST" action="/admin/linkedin/{{ post.id }}/delete" onsubmit="return confirm('Diesen LinkedIn-Beitrag wirklich löschen?')">
                  <button class="px-3 py-1.5 bg-red-50 rounded-lg text-xs font-medium text-red-500 hover:bg-red-100 transition-colors">Löschen</button>
                </form>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="px-6 py-16 text-center text-stone">
      <div class="w-16 h-16 bg-[#0A66C2]/10 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-[#0A66C2]" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
      </div>
      <p class="text-lg mb-2">Noch keine LinkedIn-Beiträge</p>
      <p class="text-sm mb-4">Fügen Sie LinkedIn-Beiträge hinzu, damit diese auf der News-Seite erscheinen.</p>
      <a href="/admin/linkedin/neu" class="inline-flex px-5 py-2.5 bg-[#D64545] text-white rounded-lg font-semibold text-sm hover:bg-[#C13B3B] transition-colors">
        Ersten Beitrag anlegen
      </a>
    </div>
  {% endif %}
</div>

{% endblock %}
