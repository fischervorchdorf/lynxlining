{% extends "layouts/admin.njk" %}

{% block admin_content %}

<div class="flex justify-between items-center mb-6">
  <div>
    {% if hasToken %}
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
        <span class="w-2 h-2 bg-green-500 rounded-full"></span> API verbunden
      </span>
    {% else %}
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
        <span class="w-2 h-2 bg-amber-500 rounded-full"></span> Kein Access Token konfiguriert
      </span>
      <p class="text-xs text-stone mt-2">Setzen Sie <code class="bg-black/5 px-1.5 py-0.5 rounded">INSTAGRAM_ACCESS_TOKEN</code> in der .env Datei.</p>
    {% endif %}
  </div>
  <form method="POST" action="/admin/instagram/sync">
    <button type="submit" class="px-5 py-2.5 bg-[#D64545] text-white rounded-lg font-semibold text-sm hover:bg-[#C13B3B] transition-colors {% if not hasToken %}opacity-50 cursor-not-allowed{% endif %}" {% if not hasToken %}disabled{% endif %}>
      Jetzt synchronisieren
    </button>
  </form>
</div>

<div class="bg-white rounded-xl border border-black/5 shadow-sm">
  {% if posts.length %}
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 p-6">
      {% for post in posts %}
        <div class="relative group bg-[#FAFAF9] rounded-xl border border-black/5 overflow-hidden {% if not post.is_visible %}opacity-50{% endif %}">
          <div class="aspect-square">
            {% if post.local_image_path %}
              <img src="{{ post.local_image_path }}" alt="" class="w-full h-full object-cover">
            {% elif post.media_url %}
              <img src="{{ post.media_url }}" alt="" class="w-full h-full object-cover">
            {% else %}
              <div class="w-full h-full bg-stone-light flex items-center justify-center">
                <svg class="w-8 h-8 text-stone/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
            {% endif %}
            {% if post.media_type == 'VIDEO' %}
              <div class="absolute top-2 left-2">
                <span class="px-2 py-0.5 bg-black/60 text-white rounded text-xs">Video</span>
              </div>
            {% endif %}
            {% if post.is_featured %}
              <div class="absolute top-2 right-2">
                <span class="px-2 py-0.5 bg-amber-500 text-white rounded text-xs font-medium">Featured</span>
              </div>
            {% endif %}
          </div>
          <div class="p-3 border-t border-black/5">
            <p class="text-xs text-stone line-clamp-2 mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              {{ post.caption | truncate(80) if post.caption else '–' }}
            </p>
            <p class="text-xs text-stone/50 mb-3">{{ post.timestamp }}</p>
            <div class="flex gap-2">
              <form method="POST" action="/admin/instagram/{{ post.id }}/toggle" class="flex-1">
                <button class="w-full px-2 py-1.5 rounded-lg text-xs font-medium transition-colors
                  {% if post.is_visible %}bg-stone/10 text-stone hover:bg-red-50 hover:text-red-500{% else %}bg-green-50 text-green-600 hover:bg-green-100{% endif %}">
                  {% if post.is_visible %}Ausblenden{% else %}Einblenden{% endif %}
                </button>
              </form>
              <form method="POST" action="/admin/instagram/{{ post.id }}/feature" class="flex-1">
                <button class="w-full px-2 py-1.5 rounded-lg text-xs font-medium transition-colors
                  {% if post.is_featured %}bg-amber-100 text-amber-700 hover:bg-amber-50{% else %}bg-stone/5 text-stone/50 hover:bg-amber-50 hover:text-amber-600{% endif %}">
                  {% if post.is_featured %}Featured{% else %}Feature{% endif %}
                </button>
              </form>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="px-6 py-16 text-center text-stone">
      <svg class="w-12 h-12 mx-auto text-stone/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <p class="text-lg mb-2">Noch keine Instagram-Posts</p>
      <p class="text-sm">Konfigurieren Sie den Instagram Access Token und klicken Sie "Jetzt synchronisieren".</p>
    </div>
  {% endif %}
</div>

{% endblock %}
