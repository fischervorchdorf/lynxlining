{% extends "layouts/admin.njk" %}

{% block admin_content %}

<a href="/admin/benutzer" class="inline-flex items-center gap-1 text-sm text-stone hover:text-[#D64545] mb-6 transition-colors">&larr; Zurück</a>

<div class="max-w-xl">
  {% if errors and errors.length %}
    <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700 space-y-1">
      {% for e in errors %}<p>{{ e }}</p>{% endfor %}
    </div>
  {% endif %}

  <form method="POST" action="/admin/benutzer{% if not isNew %}/{{ item.id }}{% endif %}" class="space-y-8" autocomplete="off">
    <div class="bg-white rounded-xl border border-black/5 shadow-sm p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Benutzername</label>
        {% if isNew %}
          <input type="text" name="username" value="{{ item.username or '' }}" required minlength="3" maxlength="50" pattern="[a-zA-Z0-9._-]+"
                 class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
        {% else %}
          <p class="text-sm font-medium text-[#1E1E1E] py-2">{{ item.username }}{% if isSelf %} <span class="text-stone font-normal">(du)</span>{% endif %}</p>
        {% endif %}
      </div>
      <div>
        <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">E-Mail</label>
        <input type="email" name="email" value="{{ item.email or '' }}" required
               class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">Rolle</label>
        <select name="role" class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
          <option value="editor" {% if item.role != 'admin' %}selected{% endif %}>Redakteur – Inhalte, Shop, Anfragen</option>
          <option value="admin" {% if item.role == 'admin' %}selected{% endif %}>Admin – zusätzlich Benutzer &amp; Adminrechte verwalten</option>
        </select>
        {% if isSelf %}<p class="mt-1 text-xs text-stone">Achtung: Wenn du dir selbst die Adminrechte entziehst, kommst du nicht mehr in die Benutzerverwaltung.</p>{% endif %}
      </div>
      <div>
        <label class="block text-xs font-semibold text-stone uppercase tracking-wider mb-1">{% if isNew %}Passwort{% else %}Neues Passwort{% endif %}</label>
        <input type="password" name="password" minlength="10" autocomplete="new-password" {% if isNew %}required{% endif %}
               class="w-full px-3 py-2 bg-[#FAFAF9] border border-black/8 rounded-lg text-sm focus:ring-2 focus:ring-[#D64545]/30 focus:border-[#D64545] outline-none">
        <p class="mt-1 text-xs text-stone">{% if isNew %}Mindestens 10 Zeichen.{% else %}Leer lassen, um das Passwort nicht zu ändern.{% endif %}</p>
      </div>
    </div>

    <button type="submit" class="px-6 py-2.5 bg-[#D64545] text-white rounded-lg font-semibold text-sm hover:bg-[#C13B3B] transition-colors">
      {% if isNew %}Benutzer anlegen{% else %}Speichern{% endif %}
    </button>
  </form>
</div>

{% endblock %}
